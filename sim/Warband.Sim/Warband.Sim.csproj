<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.1 + C# 9: the ceiling Unity 6 compiles, so this assembly drops
       into the client unchanged. No UnityEngine references, ever (ADR 0001). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Warband.Sim</RootNamespace>
  </PropertyGroup>

</Project>
