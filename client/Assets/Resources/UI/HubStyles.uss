}

.motion--reduced .hub-station,
.motion--reduced .hub-workspace,
.motion--reduced .result-gate__panel {
    transition-duration: 0.08s;
    translate: 0 0;
    scale: 1 1;
}

/* Development-build choreography preview. Deliberately plain: this is a QA instrument. */
.flow-lab {
    position: absolute;
    right: 18px;
    top: 18px;
    width: 230px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(5, 8, 13, 0.98);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(244, 184, 76);
    border-right-color: rgb(244, 184, 76);
    border-top-color: rgb(244, 184, 76);
    border-bottom-color: rgb(244, 184, 76);
}

#flow-lab-title {
    margin-bottom: 8px;
    color: rgb(248, 211, 139);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.flow-lab__button {
    min-height: 38px;
    margin-top: 4px;
    color: rgb(226, 235, 247);
    background-color: rgb(28, 38, 52);
    font-size: 12px;
    -unity-font-style: bold;
}
