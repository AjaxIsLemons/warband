}

.layout--phone .hub-station__sigil--hourstone {
    margin-right: 0;
    margin-bottom: 2px;
}

.layout--phone .hub-station__eyebrow {
    display: none;
}

.layout--phone .hub-station__name {
    font-size: 17px;
}

.layout--phone .hub-station__status {
    margin-top: 2px;
    font-size: 12px;
}

.layout--phone .hub-recommendation {
    min-height: 48px;
}

.layout--phone .hub-recommendation__value {
    font-size: 15px;
}

.layout--phone .hub-workspace__header {
    min-height: 82px;
    padding-left: 14px;
    padding-right: 14px;
}

.layout--phone .hub-back {
    min-width: 105px;
    margin-right: 12px;
}

.layout--phone .hub-workspace__title {
    font-size: 24px;
}

.layout--phone .hub-workspace__brief {
    max-height: 40px;
    font-size: 14px;
}

.layout--phone .hub-ledger {
    width: 190px;
