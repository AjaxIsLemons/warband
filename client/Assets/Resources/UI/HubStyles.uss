    margin-left: 12px;
}

.layout--phone .hub-ledger__value {
    font-size: 18px;
}

.layout--phone .hub-ledger__detail {
    font-size: 12px;
}

.layout--phone .hub-anchor-rail {
    padding-left: 10px;
