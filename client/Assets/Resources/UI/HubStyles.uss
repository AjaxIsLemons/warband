    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.layout--phone .hub-table__ring--outer {
    width: 420px;
    height: 420px;
    margin-left: -210px;
    margin-top: -210px;
}

.layout--phone .hub-table__ring--inner {
    width: 280px;
    height: 280px;
    margin-left: -140px;
    margin-top: -140px;
}

.layout--phone .hub-station {
    width: 280px;
    min-height: 78px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.layout--phone .hub-station--breach,
.layout--phone .hub-station--warband {
    margin-left: -140px;
}

.layout--phone .hub-station--breach {
    top: 8px;
}

.layout--phone .hub-station--warband {
    bottom: 8px;
}

.layout--phone .hub-station--market {
    left: 12px;
}

.layout--phone .hub-station--armory {
    right: 12px;
}

.layout--phone .hub-station--hourstone {
    width: 250px;
    min-height: 118px;
    margin-left: -125px;
    margin-top: -59px;
}

.layout--phone .hub-station__sigil {
    width: 44px;
    min-width: 44px;
    height: 44px;
    margin-right: 9px;
    padding-top: 7px;
