}

.layout--phone .wb-inspector--hub .wb-inspector__title {
    font-size: 25px;
}

.layout--phone .hub-workspace__footer {
    min-height: 62px;
    padding-left: 14px;
    padding-right: 14px;
}

.layout--phone .hub-workspace__hint {
    font-size: 13px;
}

.layout--phone .hub .management-continue {
    min-width: 250px;
    min-height: 52px;
}

.layout--phone .hub .management-choice-modal {
    width: 94%;
    max-width: 94%;
    height: 90%;
    max-height: 90%;
    padding: 20px;
}

.layout--phone .result-gate {
    padding: 12px;
}

.layout--phone .result-gate__panel {
    width: 100%;
    max-width: 100%;
    max-height: 100%;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 18px;
    padding-bottom: 18px;
}

.layout--phone .result-gate__heading {
    font-size: 34px;
}

.layout--phone .result-gate__summary {
    font-size: 16px;
}

.layout--phone .result-gate__stats {
    margin-top: 12px;
}

.layout--phone .result-stat {
    min-width: 180px;
