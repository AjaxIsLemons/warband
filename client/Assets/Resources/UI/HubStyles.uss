}

.layout--phone .hub-anchor {
    min-width: 120px;
    flex-grow: 1;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 12px;
}

.layout--phone .hub-collection {
    width: 100%;
    border-right-width: 0;
}

.layout--phone .hub-collection__toolbar {
    min-height: 52px;
    padding-left: 14px;
    padding-right: 14px;
}

.layout--phone .hub-collection__note {
    font-size: 14px;
}

.layout--phone .hub-collection__scroll {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.layout--phone .hub-card-grid {
    flex-wrap: nowrap;
}

.layout--phone .wb-card--hub {
    width: 258px;
    min-width: 258px;
    height: 500px;
}

.layout--phone .wb-card--hub .wb-card__portrait {
    height: 110px;
}

.layout--phone .wb-card--hub .wb-card__body {
    margin-top: 110px;
    min-height: 348px;
}

.layout--phone .wb-card--hub .wb-card__ability,
.layout--phone .wb-card--hub .wb-card__passive {
    min-height: 48px;
}

.layout--phone .wb-card--hub .wb-mini-stat {
    min-width: 68px;
    min-height: 42px;
}

.layout--phone .wb-card--hub .wb-card__ability-summary,
.layout--phone .wb-card--hub .wb-card__passive-summary {
    display: none;
}

.layout--phone .hub-inspector-pane {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    min-width: 620px;
