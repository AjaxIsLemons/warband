/* Shared UI foundation. This sheet is loaded first; screen styles consume these values and may
   only override them through responsive/theme classes at the document root. */

:root {
    --ui-type-display: 34px;
    --ui-type-title: 26px;
    --ui-type-heading: 20px;
    --ui-type-body: 16px;
    --ui-type-meta: 13px;

    --ui-space-1: 4px;
    --ui-space-2: 8px;
    --ui-space-3: 12px;
    --ui-space-4: 16px;
    --ui-space-5: 24px;
    --ui-space-6: 32px;

    --ui-radius-small: 4px;
    --ui-radius-medium: 7px;
    --ui-radius-large: 12px;

    --ui-hit-pointer: 44px;
    --ui-hit-coarse: 56px;
    --ui-rail-reserve: 190px;
}

.ui-safe-area-frame,
.ui-screen-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.ui-screen-host {
    flex-grow: 1;
}

.ui-rotation-guard {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding-left: 48px;
    padding-right: 48px;
    background-color: rgba(5, 9, 15, 0.99);
}

.layout--portrait-handheld .ui-rotation-guard {
    display: flex;
}

.ui-rotation-guard__title {
    color: rgb(242, 238, 224);
    font-size: var(--ui-type-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ui-rotation-guard__copy {
    max-width: 560px;
    margin-top: 12px;
    color: rgb(166, 184, 207);
    font-size: var(--ui-type-body);
    white-space: normal;
    -unity-text-align: middle-center;
}

.ui-type--body {
    font-size: var(--ui-type-body);
}

.ui-type--meta {
    font-size: var(--ui-type-meta);
}

.interaction--coarse .btn,
.interaction--coarse Button {
    min-height: var(--ui-hit-coarse);
}

.layout--ultrawide .ui-screen-host {
    padding-left: 3%;
    padding-right: 3%;
}
