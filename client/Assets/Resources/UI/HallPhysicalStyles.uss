/* Physical Hall station composition. Loaded after shared tokens so this file owns geometry. */

.hub-topbar {
    height: 60px;
    min-height: 60px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgba(6, 10, 16, 0.96);
    border-bottom-color: rgba(217, 164, 58, 0.28);
}

.hub .management-brand { width: 166px; }
.hub .management-brand__name { font-size: 19px; letter-spacing: 3px; }
.hub .management-brand__act { font-size: 12px; }
.hub .management-track-node { width: 32px; height: 32px; }
.hub .management-track-node__icon { font-size: 12px; }
.hub .management-track-node__label { font-size: 9px; }
.hub .management-track-link { width: 24px; }
.hub .management-resource {
    min-width: 92px;
    min-height: 42px;
    padding-top: 5px;
    padding-bottom: 5px;
}
.hub .management-resource__label { font-size: 10px; }
.hub .management-resource__value { font-size: 19px; }

/* Overview nameplates sit over the actual Hall props instead of replacing them. */
.hub-overview {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 12px;
    padding-bottom: 12px;
    align-items: stretch;
    background-color: rgba(5, 8, 13, 0.08);
}

.hub-overview__heading {
    position: absolute;
    left: 22px;
    top: 20px;
    width: 390px;
    min-width: 0;
    align-items: flex-start;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(6, 10, 16, 0.72);
    border-left-width: 2px;
    border-left-color: rgba(217, 164, 58, 0.72);
    border-bottom-width: 0;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}

.hub-overview__title { font-size: 22px; letter-spacing: 3px; }
.hub-overview__copy {
    margin-top: 3px;
    font-size: 14px;
    -unity-text-align: upper-left;
}

.hub-table {
    width: 100%;
    max-width: none;
    min-height: 0;
    max-height: none;
    margin-top: 0;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.hub-table__ring,
.hub-table__axis,
.hub-table__grain { opacity: 0.20; }

.hub-station {
    width: 208px;
    min-height: 74px;
    padding-left: 9px;
    padding-right: 11px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(7, 12, 19, 0.68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-left-color: rgba(93, 116, 146, 0.36);
    border-right-color: rgba(93, 116, 146, 0.36);
    border-top-color: rgba(93, 116, 146, 0.36);
    border-bottom-color: rgba(93, 116, 146, 0.84);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.hub-station:hover,
.hub-station:focus {
    background-color: rgba(17, 28, 42, 0.94);
    translate: 0 -4px;
    border-left-color: rgba(104, 165, 231, 0.82);
    border-right-color: rgba(104, 165, 231, 0.82);
    border-top-color: rgba(104, 165, 231, 0.82);
    border-bottom-color: rgb(104, 165, 231);
}

.hub-station--recommended {
    background-color: rgba(42, 31, 17, 0.82);
    border-left-color: rgba(217, 164, 58, 0.76);
    border-right-color: rgba(217, 164, 58, 0.76);
    border-top-color: rgba(217, 164, 58, 0.76);
    border-bottom-color: rgb(217, 164, 58);
}

.hub-station__sigil-vector {
    width: 48px;
    min-width: 48px;
    height: 48px;
    margin-right: 10px;
}
.hub-station__eyebrow { font-size: 10px; letter-spacing: 2px; }
.hub-station__name { margin-top: 0; font-size: 18px; letter-spacing: 2px; }
.hub-station__status {
    margin-top: 2px;
    max-height: 20px;
    overflow: hidden;
    font-size: 13px;
}

.hub-station--breach { top: 26px; width: 230px; margin-left: -115px; }
.hub-station--market { left: 7%; width: 230px; }
.hub-station--armory { right: 7%; width: 230px; }
.hub-station--warband { bottom: 26px; width: 230px; margin-left: -115px; }
.hub-station--hourstone {
    width: 188px;
    min-height: 104px;
    margin-left: -94px;
    margin-top: -52px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(30, 23, 15, 0.72);
}
.hub-station--hourstone .hub-station__sigil-vector {
    width: 52px;
    height: 52px;
    margin-right: 0;
    margin-bottom: 2px;
}
.hub-station--hourstone .hub-station__status { display: none; }

.hub-recommendation {
    position: absolute;
    left: 22px;
    bottom: 18px;
    width: 355px;
    min-height: 48px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(7, 12, 19, 0.84);
    border-left-width: 2px;
}
.hub-recommendation__hint { display: none; }
.hub-recommendation__value { font-size: 15px; }

/* Compact station ribbon. */
.hub-workspace { background-color: rgba(5, 8, 13, 0.24); }
.hub-workspace__header {
    min-height: 72px;
    height: 72px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgba(6, 10, 16, 0.90);
    border-bottom-color: rgba(83, 103, 133, 0.32);
}
.hub-back {
    min-width: 96px;
    min-height: 48px;
    margin-right: 16px;
    font-size: 13px;
}
.hub-workspace__heading {
    width: 235px;
    min-width: 235px;
    flex-grow: 0;
}
.hub-workspace__eyebrow { font-size: 10px; }
.hub-workspace__title { margin-top: 0; font-size: 24px; letter-spacing: 3px; }
.hub-workspace__brief { display: none; }
.hub-ledger {
    width: 194px;
    min-height: 52px;
    margin-left: auto;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(21, 30, 43, 0.94);
}
.hub-ledger__label { font-size: 9px; }
.hub-ledger__value { font-size: 18px; }
.hub-ledger__detail {
    max-height: 17px;
    overflow: hidden;
    font-size: 11px;
}

.hub-anchor-rail {
    position: absolute;
    left: 365px;
    right: 220px;
    top: 10px;
    height: 52px;
    min-height: 52px;
    padding-left: 0;
    padding-right: 0;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
}
.hub-anchor {
    width: 58px;
    min-width: 58px;
    height: 52px;
    margin-left: 5px;
    margin-right: 5px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(11, 17, 26, 0.74);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-left-color: rgba(83, 103, 133, 0.32);
    border-right-color: rgba(83, 103, 133, 0.32);
    border-top-color: rgba(83, 103, 133, 0.32);
    border-bottom-color: rgba(83, 103, 133, 0.66);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}
.hub-anchor:hover,
.hub-anchor:focus { background-color: rgba(25, 37, 53, 0.94); }
.hub-anchor--active {
    background-color: rgba(27, 49, 76, 0.96);
    border-left-color: rgb(104, 165, 231);
    border-right-color: rgb(104, 165, 231);
    border-top-color: rgb(104, 165, 231);
    border-bottom-color: rgb(104, 165, 231);
}
.hub-anchor__sigil { width: 32px; height: 32px; }
.hub-anchor__label { display: none; }

.hub-workspace__body {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
}
.hub-workspace__instrument {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 14px;
    bottom: 14px;
    overflow: hidden;
    opacity: 0.52;
    background-color: rgba(7, 11, 17, 0.22);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(88, 110, 141, 0.22);
    border-right-color: rgba(88, 110, 141, 0.22);
    border-top-color: rgba(88, 110, 141, 0.22);
    border-bottom-color: rgba(88, 110, 141, 0.22);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}
.hub-instrument__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: rgba(104, 165, 231, 0.12);
}
.hub-instrument__rail--left { left: 25%; }
.hub-instrument__rail--center { left: 50%; background-color: rgba(217, 164, 58, 0.15); }
.hub-instrument__rail--right { left: 75%; }
.hub-instrument__socket {
    position: absolute;
    left: 50%;
    top: 44%;
    width: 420px;
    height: 160px;
    margin-left: -210px;
    margin-top: -80px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(217, 164, 58, 0.16);
    border-right-color: rgba(217, 164, 58, 0.16);
    border-top-color: rgba(217, 164, 58, 0.16);
    border-bottom-color: rgba(217, 164, 58, 0.16);
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-left-radius: 80px;
    border-bottom-right-radius: 80px;
}

.hub-collection {
    width: 100%;
    border-right-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.hub-collection__toolbar {
    min-height: 54px;
    margin-left: 8px;
    margin-right: 8px;
    padding-left: 16px;
    padding-right: 12px;
    background-color: rgba(7, 12, 19, 0.86);
    border-bottom-width: 1px;
    border-bottom-color: rgba(83, 103, 133, 0.34);
}
.hub-collection__note { font-size: 14px; }
.hub .management-secondary {
    min-width: 170px;
    min-height: 44px;
    font-size: 13px;
}
.hub-collection__scroll {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 14px;
    padding-bottom: 10px;
}
.hub .unity-scroller { display: none; }
.hub-section-label { margin-bottom: 9px; font-size: 11px; }
.hub-section-label--secondary { margin-top: 16px; }
.hub-card-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}
.hub--market .hub-card-grid {
    width: 100%;
    flex-wrap: nowrap;
    justify-content: center;
}
.hub--market .unity-scroll-view__content-container {
    min-width: 100%;
    align-items: center;
}
.hub--market .hub-section-label--secondary,
.hub--market #secondary-grid { display: none; }

/* Station objects. */
.wb-card--hub {
    width: 236px;
    min-width: 236px;
    height: 430px;
    margin-right: 10px;
    margin-bottom: 10px;
    background-color: rgba(13, 21, 31, 0.97);
    border-bottom-width: 4px;
    border-bottom-color: rgba(67, 85, 109, 0.9);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}
.wb-card--hub:hover,
.wb-card--hub:focus { translate: 0 -5px; }
.wb-card--hub.wb-card--selected {
    translate: 0 -9px;
    border-bottom-color: rgb(104, 165, 231);
}
.wb-card--hub.wb-card--pinned {
    border-left-width: 3px;
    border-left-color: rgb(217, 164, 58);
    border-bottom-color: rgb(217, 164, 58);
    background-color: rgba(43, 33, 20, 0.98);
}
.wb-card--hub.wb-card--pinned .wb-card__selection {
    opacity: 1;
    background-color: rgb(217, 164, 58);
}
.wb-card--hub .wb-card__portrait { height: 126px; }
.wb-card--hub .wb-card__body {
    margin-top: 126px;
    min-height: 260px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
}
.wb-card--hub .wb-card__eyebrow { font-size: 10px; }
.wb-card--hub .wb-card__title { font-size: 18px; }
.wb-card--hub .wb-card__subtitle { font-size: 12px; }
.wb-card--hub .wb-mini-stat { min-width: 68px; min-height: 40px; }
.wb-card--hub .wb-mini-stat__label { font-size: 9px; }
.wb-card--hub .wb-mini-stat__value { font-size: 14px; }
.wb-card--hub .wb-card__ability,
.wb-card--hub .wb-card__passive { min-height: 48px; margin-top: 6px; }
.wb-card--hub .wb-card__rule-trigger { font-size: 9px; }
.wb-card--hub .wb-card__ability-name,
.wb-card--hub .wb-card__passive-name { font-size: 13px; }
.wb-card--hub .wb-card__footer { height: 38px; }
.wb-card--hub .wb-card__weapon,
.wb-card--hub .wb-card__price { font-size: 13px; }
.wb-card--hub-warband .wb-card__body { overflow: hidden; }
.wb-card--hub-warband .wb-card__passive,
.wb-card--hub-warband .wb-card__passive-summary,
.wb-card--hub-warband .wb-card__tags { display: none; }

.hub--armory #primary-grid .wb-card--hub {
    width: 220px;
    min-width: 220px;
    height: 330px;
}
.hub--armory #primary-grid .wb-card__portrait { height: 104px; }
.hub--armory #primary-grid .wb-card__body {
    margin-top: 104px;
    min-height: 184px;
    overflow: hidden;
}
.hub--armory #primary-grid .wb-card__ability,
.hub--armory #primary-grid .wb-card__passive,
.hub--armory #primary-grid .wb-card__tags { display: none; }
.hub--armory #secondary-grid .wb-card--hub {
    width: 220px;
    min-width: 220px;
    height: 250px;
}
.hub--armory #secondary-grid .wb-card__portrait {
    height: 118px;
}
.hub--armory #secondary-grid .wb-card__body {
    margin-top: 118px;
    min-height: 90px;
    overflow: hidden;
}
.hub--armory #secondary-grid .wb-card__subtitle,
.hub--armory #secondary-grid .wb-card__stats,
.hub--armory #secondary-grid .wb-card__ability,
.hub--armory #secondary-grid .wb-card__passive,
.hub--armory #secondary-grid .wb-card__tags {
    display: none;
}
.hub--hourstone .wb-card--hub {
    width: 340px;
    min-width: 340px;
    height: 280px;
    background-color: rgba(31, 25, 18, 0.97);
    border-bottom-color: rgba(217, 164, 58, 0.68);
}
.hub--hourstone .wb-card__portrait {
    width: 88px;
    height: 238px;
}
.hub--hourstone .wb-card__body {
    margin-left: 88px;
    margin-top: 0;
    min-height: 238px;
}

/* One contextual action surface. */
.hub-selection-tray {
    min-height: 154px;
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding-left: 18px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(8, 14, 22, 0.98);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(104, 165, 231);
    border-right-color: rgba(83, 103, 133, 0.58);
    border-top-color: rgba(83, 103, 133, 0.58);
    border-bottom-color: rgba(83, 103, 133, 0.58);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}
.hub-selection-tray__identity { flex-grow: 1; min-width: 0; }
.hub-selection-tray__eyebrow {
    color: rgb(125, 170, 226);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}
.hub-selection-tray__title {
    margin-top: 2px;
    color: rgb(239, 243, 248);
    font-size: 23px;
    -unity-font-style: bold;
    white-space: normal;
}
.hub-selection-tray__summary {
    max-width: 760px;
    max-height: 44px;
    margin-top: 5px;
    color: rgb(184, 198, 217);
    font-size: 16px;
    white-space: normal;
    overflow: hidden;
}
.hub-selection-tray__basic {
    max-width: 760px;
    max-height: 38px;
    margin-top: 4px;
    color: rgb(151, 170, 194);
    font-size: 14px;
    white-space: normal;
    overflow: hidden;
}
.hub-selection-tray__price {
    min-width: 100px;
    margin-left: 18px;
    margin-right: 18px;
    color: rgb(217, 164, 58);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.hub-selection-tray__commands { min-width: 310px; align-items: stretch; }
.hub-selection-tray__inspect { min-height: 42px; font-size: 12px; }
.hub-selection-tray__actions {
    margin-top: 6px;
    flex-direction: row;
    justify-content: flex-end;
}
.hub-selection-tray__action {
    min-width: 142px;
    min-height: 48px;
    margin-left: 6px;
    font-size: 12px;
}
.hub-selection-tray__command-hint {
    min-height: 42px;
    padding-top: 12px;
    color: rgb(217, 164, 58);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
.hub-workspace__footer { display: none; }

/* Dossier becomes progressive disclosure and owns interaction while open. */
.hub-inspector-scrim {
    position: absolute;
    left: -16px;
    right: -16px;
    top: -14px;
    bottom: -14px;
    align-items: flex-end;
    background-color: rgba(2, 5, 9, 0.70);
}
.hub-inspector-pane {
    width: 520px;
    min-width: 520px;
    height: 100%;
    background-color: rgb(8, 13, 20);
    border-left-width: 2px;
    border-left-color: rgb(104, 165, 231);
}
.hub-inspector-close { display: flex; }
.hub-inspector-scroll { padding-right: 4px; }

.hub--routing .hub-workspace,
.hub--routing .hub-overview { opacity: 0.78; }

/* Unsupported portrait gets an explicit interstitial. */
.hub-rotate-device {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(5, 9, 14);
}
.hub-rotate-device__instrument {
    width: 320px;
    align-items: center;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 28px;
    background-color: rgb(13, 20, 30);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(217, 164, 58);
    border-right-color: rgb(217, 164, 58);
    border-top-color: rgb(217, 164, 58);
    border-bottom-color: rgb(217, 164, 58);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
.hub-rotate-device__icon { color: rgb(217, 164, 58); font-size: 52px; }
.hub-rotate-device__title {
    margin-top: 10px;
    color: rgb(238, 236, 228);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}
.hub-rotate-device__copy {
    margin-top: 8px;
    color: rgb(160, 175, 196);
    font-size: 16px;
}

/* Landscape phone composition. */
.layout--phone .hub-topbar {
    height: 56px;
    min-height: 56px;
    padding-left: 12px;
    padding-right: 12px;
}
.layout--phone .hub .management-brand { width: 124px; }
.layout--phone .hub .management-brand__name { font-size: 16px; }
.layout--phone .hub .management-brand__act { font-size: 10px; }
.layout--phone .hub .management-resource { min-width: 78px; min-height: 40px; }
.layout--phone .hub .management-resource__value { font-size: 17px; }

.layout--phone .hub-overview__heading {
    left: 12px;
    top: 10px;
    width: 280px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 9px;
    padding-bottom: 9px;
}
.layout--phone .hub-overview__title { font-size: 18px; }
.layout--phone .hub-table { margin-top: 0; margin-bottom: 0; }
.layout--phone .hub-station {
    width: 176px;
    min-height: 60px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
}
.layout--phone .hub-station__sigil-vector {
    width: 38px;
    min-width: 38px;
    height: 38px;
}
.layout--phone .hub-station__name { font-size: 15px; }
.layout--phone .hub-station__status { font-size: 11px; }
.layout--phone .hub-station--market { left: 10px; }
.layout--phone .hub-station--armory { right: 10px; }
.layout--phone .hub-station--breach,
.layout--phone .hub-station--warband { width: 190px; margin-left: -95px; }
.layout--phone .hub-station--hourstone {
    width: 148px;
    min-height: 82px;
    margin-left: -74px;
    margin-top: -41px;
}
.layout--phone .hub-recommendation {
    left: 12px;
    bottom: 10px;
    width: 260px;
    min-height: 42px;
}

.layout--phone .hub-workspace__header {
    height: 54px;
    min-height: 54px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
}
.layout--phone .hub-back {
    min-width: 82px;
    min-height: 44px;
    margin-right: 10px;
    font-size: 11px;
}
.layout--phone .hub-workspace__heading { width: 180px; min-width: 180px; }
.layout--phone .hub-workspace__eyebrow { display: none; }
.layout--phone .hub-workspace__title { font-size: 19px; }
.layout--phone .hub-ledger {
    width: 160px;
    min-height: 44px;
    margin-left: auto;
}
.layout--phone .hub-ledger__label,
.layout--phone .hub-ledger__detail { display: none; }
.layout--phone .hub-anchor-rail { display: none; }
.layout--phone .hub-workspace__body {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
}
.layout--phone .hub-workspace__instrument {
    left: 8px;
    right: 8px;
    top: 6px;
    bottom: 6px;
}
.layout--phone .hub-collection__toolbar { display: none; }
.layout--phone .hub-collection__scroll {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 7px;
    padding-bottom: 5px;
}
.layout--phone .hub-section-label { display: none; }
.layout--phone .hub-card-grid { flex-wrap: nowrap; }

.layout--phone .wb-card--hub,
.layout--phone .hub--armory #primary-grid .wb-card--hub,
.layout--phone .hub--armory #secondary-grid .wb-card--hub,
.layout--phone .hub--hourstone .wb-card--hub {
    width: 218px;
    min-width: 218px;
    height: 182px;
    margin-right: 8px;
}
.layout--phone .wb-card--hub .wb-card__portrait,
.layout--phone .hub--armory #primary-grid .wb-card__portrait,
.layout--phone .hub--hourstone .wb-card__portrait {
    width: 72px;
    height: 140px;
}
.layout--phone .wb-card--hub .wb-card__body,
.layout--phone .hub--armory #primary-grid .wb-card__body,
.layout--phone .hub--hourstone .wb-card__body {
    margin-left: 72px;
    margin-top: 0;
    min-height: 140px;
    padding-left: 8px;
    padding-right: 7px;
    padding-top: 7px;
    padding-bottom: 4px;
}
.layout--phone .wb-card--hub .wb-card__eyebrow { font-size: 8px; }
.layout--phone .wb-card--hub .wb-card__title { font-size: 15px; }
.layout--phone .wb-card--hub .wb-card__subtitle,
.layout--phone .wb-card--hub .wb-card__stats,
.layout--phone .wb-card--hub .wb-card__passive,
.layout--phone .wb-card--hub .wb-card__ability-summary { display: none; }
.layout--phone .wb-card--hub .wb-card__ability {
    display: flex;
    min-height: 48px;
    margin-top: 5px;
}
.layout--phone .wb-card--hub .wb-card__ability-icon,
.layout--phone .wb-card--hub .wb-card__info {
    display: none;
}
.layout--phone .wb-card--hub .wb-card__ability-copy {
    margin-left: 0;
    margin-right: 0;
}
.layout--phone .wb-card--hub .wb-card__rule-trigger { font-size: 8px; }
.layout--phone .wb-card--hub .wb-card__ability-name { font-size: 11px; }
.layout--phone .wb-card--hub .wb-card__footer { height: 36px; }

.layout--phone .hub-selection-tray {
    min-height: 144px;
    margin-left: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    padding-left: 12px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
}
.layout--phone .hub-selection-tray__identity { width: 44%; }
.layout--phone .hub-selection-tray__eyebrow { font-size: 9px; }
.layout--phone .hub-selection-tray__title { font-size: 18px; }
.layout--phone .hub-selection-tray__summary {
    max-height: 40px;
    margin-top: 2px;
    font-size: 16px;
}
.layout--phone .hub-selection-tray__basic {
    max-height: 32px;
    margin-top: 1px;
    font-size: 13px;
}
.layout--phone .hub-selection-tray__price {
    min-width: 64px;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 18px;
}
.layout--phone .hub-selection-tray__commands { min-width: 260px; }
.layout--phone .hub-selection-tray__inspect {
    min-height: 56px;
    font-size: 12px;
}
.layout--phone .hub-selection-tray__action {
    min-width: 120px;
    min-height: 56px;
    font-size: 12px;
}
.layout--phone .hub-inspector-scrim {
    left: -8px;
    right: -8px;
    top: -6px;
    bottom: -6px;
}
.layout--phone .hub-inspector-pane { width: 100%; min-width: 100%; }
.layout--phone .wb-inspector--hub .wb-inspector__portrait { height: 120px; }
.layout--phone .hub-inspector-pane__top { height: 48px; min-height: 48px; }

.motion--reduced .hub--routing .hub-workspace,
.motion--reduced .hub--routing .hub-overview { opacity: 0.90; }

/* Unified split-stage decision workspace.
   Browse with compact Stock/Target profiles on the left; decide from one full Detail profile. */
.hub-selection-tray {
    display: none;
}

.hub-collection {
    width: 38%;
    min-width: 350px;
    flex-shrink: 0;
    background-color: rgba(6, 10, 16, 0.72);
    border-right-width: 1px;
    border-right-color: rgba(83, 103, 133, 0.50);
}

.hub-collection__toolbar {
    min-height: 62px;
    margin-left: 0;
    margin-right: 0;
    padding-left: 18px;
    padding-right: 14px;
    background-color: rgba(8, 13, 21, 0.98);
}

.hub-collection__note {
    font-size: 15px;
}

.hub-collection__scroll {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.hub-card-grid,
.hub--market .hub-card-grid,
.hub--market #primary-grid {
    width: 100%;
    min-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
}

.hub--market .unity-scroll-view__content-container {
    min-width: 100%;
    align-items: stretch;
}

.hub-inspector-scrim {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 62%;
    min-width: 0;
    height: 100%;
    flex-grow: 1;
    align-items: stretch;
    background-color: rgba(3, 6, 10, 0);
}

.hub-inspector-pane {
    width: 100%;
    min-width: 0;
    height: 100%;
    background-color: rgba(8, 13, 20, 0.985);
    border-left-width: 1px;
    border-left-color: rgba(104, 165, 231, 0.48);
}

.hub--detail-empty .hub-collection {
    width: 100%;
}

.hub-inspector-pane__top {
    height: 54px;
    min-height: 54px;
    padding-left: 22px;
    padding-right: 14px;
    background-color: rgba(6, 10, 16, 0.96);
}

.hub-inspector-pane__label {
    color: rgb(151, 183, 222);
    font-size: 12px;
}

.hub-inspector-close {
    display: flex;
    min-width: 122px;
    min-height: 40px;
    font-size: 12px;
}

.hub-inspector-scrim--expanded {
    position: absolute;
    left: -16px;
    right: -16px;
    top: -14px;
    bottom: -14px;
    width: auto;
    height: auto;
    align-items: flex-end;
    background-color: rgba(2, 5, 9, 0.78);
}

.hub-inspector-scrim--expanded .hub-inspector-pane {
    width: 760px;
    min-width: 760px;
    border-left-width: 2px;
    border-left-color: rgb(104, 165, 231);
}

.wb-inspector--hub .wb-inspector__portrait {
    height: 196px;
    min-height: 196px;
    -unity-background-scale-mode: scale-to-fit;
}

.wb-inspector--hub .wb-inspector__heading {
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 13px;
    padding-bottom: 10px;
}

.wb-inspector--hub .wb-inspector__title {
    font-size: 30px;
}

.wb-inspector--hub .wb-inspector__subtitle,
.wb-inspector--hub .wb-inspector__line-copy {
    font-size: 17px;
}

.wb-inspector--hub .wb-inspector__line-title {
    font-size: 19px;
}

.wb-inspector--hub .wb-inspector-stat {
    min-width: 116px;
    min-height: 70px;
    margin-right: 7px;
    margin-bottom: 7px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgba(19, 29, 43, 0.96);
    border-top-width: 3px;
    border-top-color: rgba(100, 124, 158, 0.62);
}

.wb-inspector--hub .wb-inspector-stat__label {
    font-size: 10px;
    letter-spacing: 1px;
}

.wb-inspector--hub .wb-inspector-stat__value {
    font-size: 22px;
}

.hub-inspector-action-dock .wb-inspector__actions {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 12px;
}

.hub-inspector-action-dock .wb-inspector__actions .btn {
    min-height: 52px;
    font-size: 14px;
}

/* Compact reusable Stock and Target profiles used by every management station. */
.wb-card--hub.decision-card--stock,
.wb-card--hub.decision-card--target {
    width: 178px;
    min-width: 178px;
    height: 226px;
    margin-left: 0;
    margin-right: 9px;
    margin-bottom: 9px;
    overflow: hidden;
    background-color: rgba(12, 19, 29, 0.99);
    border-bottom-width: 3px;
}

.wb-card--hub.decision-card--stock .wb-card__portrait,
.wb-card--hub.decision-card--target .wb-card__portrait {
    width: 100%;
    height: 126px;
}

.wb-card--hub.decision-card--stock .wb-card__body,
.wb-card--hub.decision-card--target .wb-card__body {
    margin-left: 0;
    margin-top: 126px;
    min-height: 62px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 6px;
    overflow: hidden;
}

.wb-card--hub.decision-card--stock .wb-card__eyebrow,
.wb-card--hub.decision-card--target .wb-card__eyebrow {
    font-size: 9px;
    letter-spacing: 1px;
}

.wb-card--hub.decision-card--stock .wb-card__title,
.wb-card--hub.decision-card--target .wb-card__title {
    max-height: 42px;
    font-size: 18px;
    white-space: normal;
    overflow: hidden;
}

.wb-card--hub.decision-card--stock .wb-card__subtitle,
.wb-card--hub.decision-card--target .wb-card__subtitle,
.wb-card--hub.decision-card--stock .wb-card__stats,
.wb-card--hub.decision-card--target .wb-card__stats,
.wb-card--hub.decision-card--stock .wb-card__ability,
.wb-card--hub.decision-card--target .wb-card__ability,
.wb-card--hub.decision-card--stock .wb-card__passive,
.wb-card--hub.decision-card--target .wb-card__passive,
.wb-card--hub.decision-card--stock .wb-card__tags,
.wb-card--hub.decision-card--target .wb-card__tags {
    display: none;
}

.wb-card--hub.decision-card--stock .wb-card__footer,
.wb-card--hub.decision-card--target .wb-card__footer {
    height: 38px;
    min-height: 38px;
}

.wb-card--hub.decision-card--stock .wb-card__price {
    color: rgb(238, 188, 85);
    font-size: 18px;
}

.wb-card--hub.decision-card--stock .wb-card__selection,
.wb-card--hub.decision-card--target .wb-card__selection {
    left: 7px;
    right: auto;
    top: 7px;
}

.layout--compact .hub-collection {
    width: 40%;
    min-width: 330px;
}

.layout--compact .hub-inspector-scrim {
    width: 60%;
}

.layout--compact .wb-card--hub.decision-card--stock,
.layout--compact .wb-card--hub.decision-card--target {
    width: 160px;
    min-width: 160px;
}

/* Mobile is intentionally compatibility-only for this desktop-first pass. */
.layout--phone .hub-collection {
    width: 100%;
}

.layout--phone .hub-inspector-scrim {
    position: absolute;
    left: -8px;
    right: -8px;
    top: -6px;
    bottom: -6px;
    width: auto;
    height: auto;
    align-items: flex-end;
    background-color: rgba(2, 5, 9, 0.76);
}

.layout--phone .hub-inspector-pane {
    width: 72%;
    min-width: 620px;
}

/* -------------------------------------------------------------------------
   Persistent Warband Shelf + typed decision detail.
   Capacity is a row of physical addresses; the old duplicated station ledger is gone. */

.hub-run-ribbon {
    height: 64px;
    min-height: 64px;
}

.management-resources {
    min-width: 132px;
}

.management-resource--sand {
    min-width: 120px;
}

.hub-workspace__header {
    height: 72px;
    min-height: 72px;
}

.hub-workspace__heading {
    width: 270px;
    min-width: 270px;
}

.hub-anchor-rail {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    height: 52px;
    min-height: 52px;
    margin-left: auto;
    margin-right: auto;
    flex-grow: 1;
}

.hub-workspace__body {
    min-height: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.hub-collection {
    width: 40%;
    min-width: 540px;
}

.hub-inspector-scrim {
    width: 60%;
}

.wb-inspector__overview {
    min-height: 236px;
    flex-direction: row;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(75, 96, 124, 0.44);
    background-color: rgba(10, 16, 25, 0.98);
}

.wb-inspector__summary {
    min-width: 0;
    flex-grow: 1;
    justify-content: center;
}

.wb-inspector__identity {
    min-width: 0;
    flex-grow: 1;
}

.wb-inspector--hub .wb-inspector__portrait {
    width: 34%;
    min-width: 238px;
    height: 236px;
    min-height: 236px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgba(74, 96, 126, 0.52);
    -unity-background-scale-mode: scale-to-fit;
}

.wb-inspector--hub .wb-inspector__heading {
    padding-left: 22px;
    padding-right: 18px;
    padding-top: 18px;
    padding-bottom: 12px;
}

.wb-inspector--hub .wb-inspector__stats {
    padding-left: 22px;
    padding-right: 16px;
    padding-bottom: 12px;
}

.wb-inspector__sections {
    padding-top: 14px;
    padding-bottom: 2px;
}

.wb-inspector--hub .wb-inspector__section--comparison,
.wb-inspector--hub .wb-inspector__section--choices,
.wb-inspector--hub .wb-inspector__section--capacity {
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 12px;
    background-color: rgba(20, 31, 45, 0.94);
    border-left-width: 3px;
    border-left-color: rgb(104, 165, 231);
}

.wb-inspector__line-body {
    min-width: 0;
    flex-grow: 1;
}

.wb-inspector__section--choices .wb-inspector__choice-preview-options {
    flex-direction: row;
    flex-wrap: wrap;
}

.wb-capacity-detail {
    flex-direction: row;
    align-items: center;
}

.wb-capacity-detail__sockets {
    min-width: 286px;
    margin-right: 18px;
    flex-direction: row;
}

.wb-capacity-detail__socket {
    width: 40px;
    height: 40px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    color: rgb(112, 130, 153);
    background-color: rgba(8, 13, 21, 0.96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(69, 88, 113, 0.72);
    border-right-color: rgba(69, 88, 113, 0.72);
    border-top-color: rgba(69, 88, 113, 0.72);
    border-bottom-color: rgba(69, 88, 113, 0.72);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.wb-capacity-detail__socket--active {
    color: rgb(236, 232, 223);
    border-left-color: rgb(101, 201, 154);
    border-right-color: rgb(101, 201, 154);
    border-top-color: rgb(101, 201, 154);
    border-bottom-color: rgb(101, 201, 154);
}

.wb-capacity-detail__socket--new {
    color: rgb(7, 11, 17);
    background-color: rgb(217, 164, 58);
    border-left-color: rgb(246, 211, 127);
    border-right-color: rgb(246, 211, 127);
    border-top-color: rgb(246, 211, 127);
    border-bottom-color: rgb(246, 211, 127);
}

.warband-shelf {
    height: 116px;
    min-height: 116px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(6, 10, 16, 0.995);
    border-top-width: 2px;
    border-top-color: rgba(90, 119, 154, 0.82);
}

.warband-shelf__identity {
    width: 136px;
    min-width: 136px;
    height: 92px;
    margin-right: 12px;
    padding-left: 12px;
    padding-right: 12px;
    align-items: flex-start;
    justify-content: center;
    background-color: rgba(15, 24, 36, 0.98);
    border-left-width: 2px;
    border-left-color: rgb(217, 164, 58);
}

.warband-shelf__identity:hover,
.warband-shelf__identity:focus,
.warband-shelf__armory:hover,
.warband-shelf__armory:focus {
    background-color: rgba(27, 43, 63, 0.99);
    border-top-color: rgb(104, 165, 231);
    border-bottom-color: rgb(104, 165, 231);
}

.warband-shelf__eyebrow,
.warband-shelf__section-label {
    color: rgb(142, 161, 186);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
}

.warband-shelf__capacity {
    margin-top: 5px;
    color: rgb(236, 232, 223);
    font-size: 20px;
    -unity-font-style: bold;
}

.warband-shelf__manage {
    margin-top: 7px;
    color: rgb(217, 164, 58);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.warband-shelf__slots {
    height: 94px;
    flex-direction: row;
    align-items: center;
}

.warband-shelf__divider {
    width: 1px;
    height: 76px;
    margin-left: 10px;
    margin-right: 12px;
    background-color: rgba(103, 128, 161, 0.58);
}

.warband-shelf__reserve {
    height: 96px;
    min-width: 190px;
    justify-content: center;
}

.warband-shelf__reserve .warband-shelf__section-label {
    margin-left: 4px;
    margin-bottom: 3px;
}

.warband-shelf__armory {
    width: 170px;
    min-width: 170px;
    height: 92px;
    margin-left: auto;
    padding-left: 12px;
    padding-right: 12px;
    align-items: flex-start;
    justify-content: center;
    background-color: rgba(15, 24, 36, 0.98);
    border-left-width: 1px;
    border-left-color: rgba(90, 119, 154, 0.72);
}

.warband-shelf__stored-count {
    margin-top: 4px;
    color: rgb(236, 232, 223);
    font-size: 17px;
    -unity-font-style: bold;
}

.warband-shelf__stored-icons {
    height: 28px;
    margin-top: 5px;
    flex-direction: row;
}

.warband-shelf__stored-icon,
.warband-shelf__stored-overflow {
    width: 26px;
    height: 26px;
    margin-right: 4px;
    padding-top: 4px;
    color: rgb(198, 211, 228);
    background-color: rgba(7, 12, 19, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(86, 109, 139, 0.72);
    border-right-color: rgba(86, 109, 139, 0.72);
    border-top-color: rgba(86, 109, 139, 0.72);
    border-bottom-color: rgba(86, 109, 139, 0.72);
    -unity-text-align: middle-center;
}

.party-slot {
    position: relative;
    width: 78px;
    min-width: 78px;
    height: 88px;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    overflow: visible;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 21, 32, 0.98);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(69, 90, 116, 0.90);
    border-right-color: rgba(69, 90, 116, 0.90);
    border-top-color: rgba(69, 90, 116, 0.90);
    border-bottom-color: rgba(69, 90, 116, 0.90);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.party-slot:hover,
.party-slot:focus,
.party-slot--focused {
    background-color: rgba(25, 42, 61, 0.99);
    border-left-color: rgb(104, 165, 231);
    border-right-color: rgb(104, 165, 231);
    border-top-color: rgb(104, 165, 231);
    border-bottom-color: rgb(104, 165, 231);
    translate: 0 -3px;
}

.party-slot--reserve {
    width: 72px;
    min-width: 72px;
}

.party-slot--locked {
    opacity: 0.56;
    border-left-color: rgba(73, 86, 104, 0.58);
    border-right-color: rgba(73, 86, 104, 0.58);
    border-top-color: rgba(73, 86, 104, 0.58);
    border-bottom-color: rgba(73, 86, 104, 0.58);
}

.party-slot--empty {
    background-color: rgba(9, 15, 23, 0.84);
    border-left-color: rgba(74, 108, 143, 0.72);
    border-right-color: rgba(74, 108, 143, 0.72);
    border-top-color: rgba(74, 108, 143, 0.72);
    border-bottom-color: rgba(74, 108, 143, 0.72);
}

.party-slot__portrait {
    position: absolute;
    left: 3px;
    right: 3px;
    top: 3px;
    bottom: 19px;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 30, 43, 1);
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.party-slot__fallback {
    color: rgb(222, 229, 239);
    font-size: 22px;
    -unity-font-style: bold;
}

.party-slot__rank {
    position: absolute;
    left: 5px;
    top: 5px;
    width: 24px;
    height: 22px;
    padding-top: 2px;
    color: rgb(8, 12, 18);
    background-color: rgb(217, 164, 58);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.party-slot__loadout {
    position: absolute;
    left: 5px;
    right: 5px;
    bottom: -2px;
    height: 25px;
    flex-direction: row;
    justify-content: center;
}

.party-slot__equipment {
    width: 25px;
    height: 25px;
    margin-left: 2px;
    margin-right: 2px;
    padding-top: 3px;
    color: rgb(236, 232, 223);
    background-color: rgba(8, 13, 20, 1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(98, 123, 156, 0.86);
    border-right-color: rgba(98, 123, 156, 0.86);
    border-top-color: rgba(98, 123, 156, 0.86);
    border-bottom-color: rgba(98, 123, 156, 0.86);
    -unity-text-align: middle-center;
}

.party-slot__equipment--empty {
    color: rgb(79, 95, 117);
    border-left-color: rgba(65, 80, 101, 0.62);
    border-right-color: rgba(65, 80, 101, 0.62);
    border-top-color: rgba(65, 80, 101, 0.62);
    border-bottom-color: rgba(65, 80, 101, 0.62);
}

.party-slot__empty-mark {
    color: rgb(116, 142, 174);
    font-size: 28px;
}

.party-slot__number {
    position: absolute;
    right: 7px;
    bottom: 5px;
    color: rgb(93, 110, 132);
    font-size: 10px;
}

.loadout-scrim {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 10px;
    bottom: 10px;
    align-items: stretch;
    justify-content: center;
    background-color: rgba(2, 5, 9, 0.82);
}

.loadout-table {
    width: 100%;
    height: 100%;
    background-color: rgba(7, 12, 19, 0.998);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(104, 165, 231, 0.72);
    border-right-color: rgba(104, 165, 231, 0.72);
    border-top-color: rgba(104, 165, 231, 0.72);
    border-bottom-color: rgba(104, 165, 231, 0.72);
}

.loadout-table__header {
    height: 70px;
    min-height: 70px;
    padding-left: 20px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(13, 21, 32, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(83, 105, 135, 0.58);
}

.loadout-table__title {
    color: rgb(236, 232, 223);
    font-size: 23px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.loadout-table__copy {
    margin-top: 3px;
    color: rgb(139, 154, 176);
    font-size: 14px;
}

.loadout-table__close {
    width: 126px;
    min-height: 46px;
}

.loadout-table__body {
    min-height: 0;
    flex-grow: 1;
    flex-direction: row;
}

.loadout-column {
    min-width: 0;
    padding: 14px;
    border-right-width: 1px;
    border-right-color: rgba(73, 94, 122, 0.48);
}

.loadout-column--formation { width: 30%; }
.loadout-column--champion { width: 36%; }
.loadout-column--armory {
    width: 34%;
    border-right-width: 0;
}

.loadout-column__label {
    margin-bottom: 9px;
    color: rgb(146, 169, 199);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
}

.loadout-column__label--reserve {
    margin-top: 16px;
}

.loadout-slot-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.party-slot--loadout {
    width: 104px;
    min-width: 104px;
    height: 116px;
    margin-right: 8px;
    margin-bottom: 9px;
}

.party-slot--loadout.party-slot--reserve {
    width: 104px;
    min-width: 104px;
}

.loadout-champion-scroll,
.loadout-inventory-scroll {
    min-height: 0;
    flex-grow: 1;
}

.loadout-inspector-slot,
.loadout-inventory {
    min-width: 100%;
}

.wb-inspector--loadout {
    min-width: 100%;
    background-color: rgba(9, 15, 23, 1);
}

.wb-inspector--loadout .wb-inspector__overview {
    min-height: 184px;
}

.wb-inspector--loadout .wb-inspector__portrait {
    width: 38%;
    min-width: 160px;
    height: 184px;
    min-height: 184px;
    -unity-background-scale-mode: scale-to-fit;
}

.wb-inspector--loadout .wb-inspector__heading {
    padding: 12px;
}

.wb-inspector--loadout .wb-inspector__title {
    font-size: 22px;
}

.wb-inspector--loadout .wb-inspector__subtitle,
.wb-inspector--loadout .wb-inspector__line-copy {
    font-size: 14px;
}

.wb-inspector--loadout .wb-inspector__stats {
    padding-left: 12px;
    padding-right: 8px;
}

.wb-inspector--loadout .wb-inspector__section {
    margin-left: 12px;
    margin-right: 12px;
}

.loadout-action-dock {
    flex-shrink: 0;
    background-color: rgba(8, 13, 20, 1);
    border-top-width: 1px;
    border-top-color: rgba(79, 101, 130, 0.56);
}

.loadout-action-dock .wb-inspector__actions {
    padding: 10px;
    flex-direction: row;
    flex-wrap: wrap;
}

.loadout-action-dock .btn {
    min-height: 44px;
    margin-right: 6px;
}

.loadout-armory-heading {
    flex-direction: row;
    justify-content: space-between;
}

.loadout-armory-count {
    color: rgb(217, 164, 58);
    font-size: 13px;
    -unity-font-style: bold;
}

.loadout-inventory {
    flex-direction: row;
    flex-wrap: wrap;
}

.loadout-inventory-empty {
    min-height: 290px;
    margin-top: 22px;
    padding-left: 34px;
    padding-right: 34px;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 22, 0.74);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(61, 84, 112, 0.68);
    border-right-color: rgba(61, 84, 112, 0.68);
    border-top-color: rgba(61, 84, 112, 0.68);
    border-bottom-color: rgba(61, 84, 112, 0.68);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.loadout-inventory-empty__mark {
    color: rgb(104, 165, 231);
    font-size: 48px;
}

.loadout-inventory-empty__title {
    margin-top: 8px;
    color: rgb(224, 229, 236);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1.8px;
}

.loadout-inventory-empty__copy {
    max-width: 340px;
    margin-top: 9px;
    color: rgb(139, 154, 176);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.loadout-inventory .wb-card--hub.decision-card--stock {
    width: 154px;
    min-width: 154px;
    height: 204px;
}

.loadout--open .warband-shelf {
    border-top-color: rgb(217, 164, 58);
}

.motion--reduced .party-slot:hover,
.motion--reduced .party-slot:focus,
.motion--reduced .party-slot--focused {
    translate: 0 0;
}

.layout--compact .party-slot {
    width: 68px;
    min-width: 68px;
}

.layout--compact .warband-shelf__identity {
    width: 122px;
    min-width: 122px;
}

.layout--compact .warband-shelf__armory {
    width: 148px;
    min-width: 148px;
}

.layout--compact .hub-collection {
    min-width: 470px;
}

/* Phone support remains compatibility-only while the dedicated composition is deferred. */
.layout--phone .warband-shelf {
    display: none;
}

.layout--phone .loadout-scrim {
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
}

/* UI proposal slice: one dominant next-beat decision over the physical Table.
   The persistent shell bar owns Warband management, so the old station and helper
   callouts no longer compete with the route the player is here to take. */
.hub-overview {
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.hub-overview__heading,
.hub-recommendation,
.hub-station--warband {
    display: none;
}

.hub-table__ring,
.hub-table__axis,
.hub-table__grain {
    opacity: 0.08;
}

.hub-station--breach {
    left: 50%;
    top: 28px;
    width: 560px;
    min-height: 190px;
    margin-left: -280px;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 22px;
    padding-bottom: 84px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(7, 11, 17, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(217, 164, 58, 0.78);
    border-right-color: rgba(217, 164, 58, 0.78);
    border-top-color: rgba(217, 164, 58, 0.78);
    border-bottom-color: rgba(217, 164, 58, 0.78);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.hub-station--breach:hover,
.hub-station--breach:focus {
    background-color: rgba(17, 23, 32, 0.985);
    border-left-color: rgb(239, 190, 87);
    border-right-color: rgb(239, 190, 87);
    border-top-color: rgb(239, 190, 87);
    border-bottom-color: rgb(239, 190, 87);
}

.hub-station--breach .hub-station__sigil-vector {
    width: 70px;
    min-width: 70px;
    height: 70px;
    margin-right: 22px;
}

.hub-station--breach .hub-station__eyebrow {
    color: rgb(217, 164, 58);
    font-size: 12px;
    letter-spacing: 2.4px;
}

.hub-station--breach .hub-station__name {
    margin-top: 3px;
    font-size: 34px;
    letter-spacing: 4px;
}

.hub-station--breach .hub-station__status {
    margin-top: 5px;
    font-size: 14px;
}

.hub-station--breach .hub-station__attention {
    display: none;
}

.hub-station__action {
    position: absolute;
    left: 30px;
    right: 30px;
    bottom: 18px;
    height: 54px;
    padding-top: 15px;
    color: rgb(21, 16, 10);
    background-color: rgb(217, 164, 58);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(246, 211, 127);
    border-right-color: rgb(246, 211, 127);
    border-top-color: rgb(246, 211, 127);
    border-bottom-color: rgb(246, 211, 127);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1.8px;
    -unity-text-align: middle-center;
}

.hub-station--breach:disabled .hub-station__action {
    color: rgb(132, 136, 143);
    background-color: rgb(38, 43, 51);
    border-left-color: rgba(105, 117, 133, 0.62);
    border-right-color: rgba(105, 117, 133, 0.62);
    border-top-color: rgba(105, 117, 133, 0.62);
    border-bottom-color: rgba(105, 117, 133, 0.62);
}

.hub-station--market,
.hub-station--armory {
    top: 58%;
    width: 248px;
    min-height: 82px;
    margin-top: -41px;
    background-color: rgba(7, 12, 19, 0.88);
}

.hub-station--market {
    left: 9%;
}

.hub-station--armory {
    right: 9%;
}

.hub-station--hourstone {
    left: 50%;
    top: auto;
    bottom: 24px;
    width: 238px;
    min-height: 78px;
    margin-left: -119px;
    margin-top: 0;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 9px;
    padding-bottom: 9px;
    flex-direction: row;
    justify-content: center;
    background-color: rgba(12, 15, 20, 0.88);
}

.hub-station--hourstone .hub-station__sigil-vector {
    width: 46px;
    min-width: 46px;
    height: 46px;
    margin-right: 10px;
    margin-bottom: 0;
}

.hub-station--hourstone .hub-station__copy {
    align-items: flex-start;
    flex-grow: 0;
}

.hub-station--hourstone .hub-station__name {
    font-size: 18px;
}

.layout--compact .hub-station--breach {
    width: 500px;
    min-height: 174px;
    margin-left: -250px;
}

.layout--compact .hub-station--market {
    left: 4%;
}

.layout--compact .hub-station--armory {
    right: 4%;
}

.layout--short .hub-station--breach {
    top: 14px;
    min-height: 154px;
    padding-top: 16px;
    padding-bottom: 68px;
}

.layout--short .hub-station__action {
    bottom: 12px;
    height: 44px;
    padding-top: 11px;
    font-size: 16px;
}

.layout--short .hub-station--market,
.layout--short .hub-station--armory {
    top: 61%;
}

.layout--short .hub-station--hourstone {
    bottom: 10px;
}

.layout--phone .hub-overview {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.layout--phone .hub-station--breach {
    top: 8px;
    width: 380px;
    min-height: 132px;
    margin-left: -190px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 12px;
    padding-bottom: 54px;
}

.layout--phone .hub-station--breach .hub-station__sigil-vector {
    width: 48px;
    min-width: 48px;
    height: 48px;
    margin-right: 12px;
}

.layout--phone .hub-station--breach .hub-station__eyebrow {
    display: flex;
    font-size: 9px;
}

.layout--phone .hub-station--breach .hub-station__name {
    font-size: 23px;
}

.layout--phone .hub-station--breach .hub-station__status {
    font-size: 11px;
}

.layout--phone .hub-station__action {
    left: 18px;
    right: 18px;
    bottom: 9px;
    height: 36px;
    padding-top: 8px;
    font-size: 13px;
}

.layout--phone .hub-station--market,
.layout--phone .hub-station--armory {
    top: 61%;
    width: 174px;
    min-height: 60px;
    margin-top: -30px;
}

.layout--phone .hub-station--market {
    left: 8px;
}

.layout--phone .hub-station--armory {
    right: 8px;
}

.layout--phone .hub-station--hourstone {
    bottom: 8px;
    width: 168px;
    min-height: 58px;
    margin-left: -84px;
}

/* Inbox Market redesign: one command ribbon, one decision workspace, one compact party rail. */
.hub-command-ribbon {
    height: 72px;
    min-height: 72px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: stretch;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(5, 9, 15, 0.995);
    border-bottom-width: 1px;
    border-bottom-color: rgba(84, 106, 135, 0.70);
}

.hub-command-ribbon__identity {
    width: 300px;
    min-width: 300px;
    flex-direction: row;
    align-items: center;
}

.hub-command-ribbon .hub-back {
    width: 80px;
    min-width: 80px;
    min-height: 46px;
    margin-right: 10px;
}

.hub-command-ribbon .management-brand {
    width: auto;
    min-width: 0;
    flex-grow: 1;
    justify-content: center;
}

.management-brand__context {
    flex-direction: row;
    align-items: center;
}

.hub-command-ribbon .management-brand__name {
    margin-right: 8px;
    font-size: 10px;
    letter-spacing: 1.2px;
}

.hub-command-ribbon .management-brand__act {
    font-size: 10px;
}

.management-brand__page {
    min-width: 0;
    flex-direction: row;
    align-items: baseline;
}

.hub-command-ribbon .hub-workspace__title {
    max-width: 194px;
    margin-right: 8px;
    font-size: 21px;
    letter-spacing: 2px;
    white-space: nowrap;
    overflow: hidden;
}

.hub-command-ribbon .hub-workspace__eyebrow {
    color: rgb(228, 177, 66);
    font-size: 10px;
    white-space: nowrap;
}

.hub-command-ribbon .management-track {
    width: 240px;
    min-width: 176px;
    flex-grow: 0;
    flex-shrink: 1;
    justify-content: center;
}

.hub-command-ribbon .hub-anchor-rail {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    width: auto;
    min-width: 344px;
    height: 100%;
    min-height: 0;
    margin-left: auto;
    margin-right: 8px;
    flex-grow: 0;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-end;
}

.hub-command-ribbon .hub-anchor {
    width: 86px;
    min-width: 86px;
    height: 100%;
    margin-left: 0;
    margin-right: 0;
    padding-left: 5px;
    padding-right: 5px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-left-width: 1px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 3px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.hub-command-ribbon .hub-anchor__sigil {
    width: 24px;
    height: 24px;
    margin-right: 4px;
}

.hub-command-ribbon .hub-anchor__label {
    display: flex;
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.25px;
    white-space: nowrap;
}

.hub-command-ribbon .management-continue {
    min-width: 150px;
    height: 46px;
    min-height: 46px;
    align-self: center;
    margin-right: 8px;
    color: rgb(233, 185, 79);
    background-color: rgba(16, 23, 33, 0.98);
    border-left-color: rgba(217, 164, 58, 0.88);
    border-right-color: rgba(217, 164, 58, 0.88);
    border-top-color: rgba(217, 164, 58, 0.88);
    border-bottom-color: rgba(217, 164, 58, 0.88);
    font-size: 10px;
}

.hub-command-ribbon .management-resources {
    min-width: 64px;
    width: 64px;
}

.hub-command-ribbon .management-resource--sand {
    min-width: 58px;
    min-height: 46px;
    padding-left: 6px;
    padding-right: 6px;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 19, 28, 0.96);
}

.hub-command-ribbon .management-resource__value--sand .currency-amount__value {
    font-size: 20px;
}

.hub-command-ribbon .management-resource__value--sand .currency-amount__icon {
    width: 22px;
    height: 22px;
}

.hub--overview .hub-command-ribbon .hub-back,
.hub--overview .hub-command-ribbon .hub-anchor-rail,
.hub--overview .hub-command-ribbon .management-continue {
    display: none;
}

.hub--overview .hub-command-ribbon__identity {
    width: 320px;
}

.hub--overview .hub-command-ribbon .management-track {
    margin-left: auto;
    margin-right: auto;
}

.hub-workspace__body {
    flex-grow: 1;
}

.hub-collection {
    width: 42%;
    min-width: 0;
}

.hub-inspector-scrim {
    width: 58%;
}

.hub--market .hub-section-label,
.hub--market .market-offer-page {
    display: none;
}

.hub-collection__footer {
    min-height: 22px;
    flex-shrink: 0;
    padding-left: 18px;
    padding-right: 14px;
    padding-top: 4px;
    color: rgb(112, 130, 153);
    background-color: rgba(6, 10, 16, 0.96);
    font-size: 10px;
}

.hub-inspector-close {
    display: flex;
    position: absolute;
    right: 10px;
    top: 10px;
    width: 36px;
    min-width: 36px;
    height: 36px;
    min-height: 36px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 16px;
}

.wb-inspector__overview {
    min-height: 176px;
}

.wb-inspector--hub .wb-inspector__portrait {
    min-width: 184px;
    height: 176px;
    min-height: 176px;
}

.wb-inspector--hub .wb-inspector__heading {
    padding-top: 10px;
    padding-right: 54px;
}

.wb-inspector__decision-body {
    min-width: 0;
    flex-direction: row;
    align-items: stretch;
}

.wb-inspector__column {
    min-width: 0;
    flex-grow: 1;
}

.wb-inspector__column--secondary {
    display: none;
    width: 50%;
    border-left-width: 1px;
    border-left-color: rgba(67, 86, 112, 0.58);
}

.wb-inspector--recruit .wb-inspector__column--profile,
.wb-inspector--recruit .wb-inspector__column--secondary {
    width: 50%;
    flex-basis: 0;
}

.wb-equipment-preview {
    width: 58%;
    min-width: 360px;
    flex-shrink: 0;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 9px;
    border-left-width: 1px;
    border-left-color: rgba(67, 86, 112, 0.72);
    background-color: rgba(8, 14, 22, 0.86);
}

.wb-equipment-preview__label {
    margin-bottom: 5px;
}

.wb-equipment-preview__recipients {
    min-height: 46px;
    flex-direction: row;
    flex-wrap: wrap;
}

.wb-recipient {
    position: relative;
    width: 31%;
    min-width: 126px;
    height: 44px;
    min-height: 44px;
    margin-right: 6px;
    margin-bottom: 5px;
    padding-left: 43px;
    padding-right: 7px;
    justify-content: center;
    align-items: flex-start;
    overflow: hidden;
    background-color: rgba(16, 25, 37, 0.98);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(72, 94, 122, 0.82);
    border-right-color: rgba(72, 94, 122, 0.82);
    border-top-color: rgba(72, 94, 122, 0.82);
    border-bottom-color: rgba(72, 94, 122, 0.82);
}

.wb-recipient:focus {
    border-left-color: rgb(104, 165, 231);
    border-right-color: rgb(104, 165, 231);
    border-top-color: rgb(104, 165, 231);
    border-bottom-color: rgb(104, 165, 231);
}

.wb-recipient--selected {
    background-color: rgba(38, 35, 24, 0.99);
    border-left-color: rgb(217, 164, 58);
    border-right-color: rgb(217, 164, 58);
    border-top-color: rgb(217, 164, 58);
    border-bottom-color: rgb(217, 164, 58);
}

.wb-recipient__portrait {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-and-crop;
}

.wb-recipient__fallback {
    font-size: 10px;
}

.wb-recipient__rank {
    color: rgb(217, 164, 58);
    font-size: 8px;
}

.wb-recipient__name {
    max-width: 100%;
    margin-top: 2px;
    color: rgb(230, 235, 242);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.wb-equipment-preview__title {
    min-height: 28px;
    margin-top: 2px;
    padding-top: 6px;
    color: rgb(205, 215, 228);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(15, 23, 34, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: rgba(75, 96, 124, 0.54);
}

.wb-equipment-preview__comparisons {
    flex-direction: row;
    flex-wrap: wrap;
}

.wb-equipment-preview__comparisons .wb-comparison {
    width: 50%;
    min-width: 0;
    min-height: 29px;
    margin-top: 0;
    padding-left: 36px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(54, 70, 92, 0.46);
}

.wb-equipment-preview__comparisons .wb-comparison__label {
    width: 82px;
    min-width: 0;
    flex-shrink: 1;
    letter-spacing: 0.5px;
}

.wb-equipment-preview__comparisons .wb-comparison__before,
.wb-equipment-preview__comparisons .wb-comparison__after {
    min-width: 54px;
    flex-shrink: 1;
    font-size: 14px;
}

.wb-equipment-preview__comparisons .wb-comparison__arrow {
    width: 22px;
    min-width: 22px;
}

.wb-comparison__direction {
    width: 18px;
    min-width: 18px;
    color: rgb(148, 164, 184);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.wb-comparison--good .wb-comparison__direction {
    color: rgb(105, 216, 154);
}

.wb-comparison--bad .wb-comparison__direction {
    color: rgb(224, 119, 108);
}

.wb-comparison--contextual .wb-comparison__direction {
    color: rgb(231, 185, 84);
}

.wb-equipment-preview__rule-deltas {
    margin-top: 5px;
    flex-direction: row;
}

.wb-rule-delta {
    min-width: 0;
    min-height: 42px;
    flex-basis: 0;
    flex-grow: 1;
    margin-right: 6px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 5px;
    background-color: rgba(13, 21, 31, 0.96);
    border-left-width: 2px;
}

.wb-rule-delta--loss {
    border-left-color: rgb(210, 91, 78);
}

.wb-rule-delta--gain {
    border-left-color: rgb(93, 194, 137);
}

.wb-rule-delta--inactive {
    opacity: 0.68;
    border-left-color: rgb(217, 164, 58);
}

.wb-rule-delta--inactive .wb-rule-delta__label {
    color: rgb(231, 185, 84);
}

.wb-rule-delta__label {
    color: rgb(151, 169, 191);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.wb-rule-delta--loss .wb-rule-delta__label {
    color: rgb(231, 112, 96);
}

.wb-rule-delta--gain .wb-rule-delta__label {
    color: rgb(111, 213, 158);
}

.wb-rule-delta__copy {
    margin-top: 3px;
    color: rgb(196, 207, 221);
    font-size: 11px;
    white-space: normal;
}

.wb-comparison--contextual .wb-comparison__after {
    color: rgb(231, 185, 84);
}

.warband-shelf {
    height: 84px;
    min-height: 84px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.warband-shelf__identity,
.warband-shelf__armory {
    height: 70px;
}

.warband-shelf__slots {
    height: 72px;
}

.warband-shelf__reserve {
    height: 72px;
}

.party-slot {
    height: 68px;
}

.party-slot--previewed {
    background-color: rgba(43, 37, 22, 0.99);
    border-left-color: rgb(217, 164, 58);
    border-right-color: rgb(217, 164, 58);
    border-top-color: rgb(217, 164, 58);
    border-bottom-color: rgb(217, 164, 58);
}

.layout--compact .hub-command-ribbon__identity {
    width: 252px;
    min-width: 252px;
}

.layout--compact .hub-command-ribbon .management-track {
    width: 172px;
    min-width: 150px;
}

.layout--compact .hub-command-ribbon .hub-anchor-rail {
    min-width: 328px;
}

.layout--compact .hub-command-ribbon .hub-anchor {
    width: 82px;
    min-width: 82px;
}

.layout--compact .hub-command-ribbon .hub-anchor__label {
    display: flex;
}

.layout--compact .hub-command-ribbon .management-continue {
    min-width: 116px;
}

.layout--compact .hub-collection {
    width: 43%;
    min-width: 0;
}

.layout--compact .hub-inspector-scrim {
    width: 57%;
}

.layout--compact .wb-equipment-preview {
    width: 62%;
    min-width: 320px;
}

.hub--market .hub-collection__toolbar {
    height: 58px;
    min-height: 58px;
    padding-left: 14px;
    padding-right: 12px;
}

.hub--market .management-secondary {
    min-width: 150px;
    min-height: 42px;
    font-size: 11px;
}

.hub--market .hub-collection__scroll {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 8px;
    overflow: hidden;
}

.hub--market .hub-inspector-scroll {
    overflow: hidden;
}

.hub--market .hub-inspector-slot {
    flex-grow: 0;
}

.hub--market .wb-inspector--hub {
    height: auto;
    min-height: 0;
    padding-bottom: 0;
}

.hub--market .wb-inspector__content {
    flex-grow: 0;
}

.hub--market .wb-inspector--hub .wb-inspector__section {
    margin-left: 16px;
    margin-right: 16px;
    margin-bottom: 8px;
    padding-top: 8px;
}

.hub--market .wb-inspector--hub .wb-inspector__line-icon {
    width: 34px;
    height: 34px;
    margin-right: 10px;
}

.hub--market .wb-inspector--hub .wb-inspector__line-title {
    font-size: 16px;
}

.hub--market .wb-inspector--hub .wb-inspector__line-copy {
    font-size: 14px;
}

.hub--market .wb-inspector__tags {
    margin-top: 0;
}

.hub--market .hub-inspector-action-dock .wb-inspector__actions {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 9px;
}

.hub--market .hub-inspector-action-dock .wb-inspector__actions .btn {
    min-height: 46px;
    font-size: 12px;
}

.layout--compact .hub-command-ribbon {
    height: 68px;
    min-height: 68px;
    padding-left: 8px;
    padding-right: 8px;
}

.layout--compact .hub-command-ribbon .hub-back {
    width: 72px;
    min-width: 72px;
    margin-right: 7px;
    font-size: 9px;
}

.layout--compact .hub-command-ribbon .hub-workspace__title {
    max-width: 164px;
    font-size: 18px;
    letter-spacing: 1.5px;
}

.layout--compact .hub-command-ribbon .hub-anchor__sigil {
    width: 21px;
    height: 21px;
}

.layout--compact .hub-command-ribbon .hub-anchor__label {
    font-size: 7px;
    letter-spacing: 0;
}

.layout--compact .hub-command-ribbon .management-resources {
    min-width: 58px;
    width: 58px;
}

.layout--compact.hub--market .hub-collection__toolbar {
    height: 50px;
    min-height: 50px;
}

.layout--compact.hub--market .management-secondary {
    min-width: 126px;
    min-height: 38px;
}

.layout--compact.hub--market .hub-collection__scroll {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 6px;
}

.layout--compact.hub--market .hub-collection__footer {
    min-height: 20px;
    padding-left: 10px;
    padding-top: 3px;
    font-size: 9px;
}

.layout--compact.hub--market .wb-inspector__overview {
    min-height: 158px;
}

.layout--compact.hub--market .wb-inspector--hub .wb-inspector__portrait {
    min-width: 160px;
    height: 158px;
    min-height: 158px;
}

.layout--compact.hub--market .wb-inspector--hub .wb-inspector__title {
    font-size: 25px;
}

.layout--compact.hub--market .wb-inspector--hub .wb-inspector-stat {
    min-width: 76px;
    min-height: 44px;
    margin-right: 5px;
    margin-bottom: 5px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.layout--compact.hub--market .wb-inspector--hub .wb-inspector-stat__value {
    font-size: 17px;
}

.layout--compact.hub--market .wb-inspector--hub .wb-inspector__section {
    margin-left: 12px;
    margin-right: 12px;
    margin-bottom: 6px;
    padding-top: 6px;
}

.layout--compact.hub--market .wb-inspector--hub .wb-inspector__line-copy {
    font-size: 13px;
}

.layout--compact.hub--market .wb-equipment-preview {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 6px;
}

.layout--compact.hub--market .hub-inspector-action-dock .wb-inspector__actions {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 5px;
}

.layout--compact.hub--market .hub-inspector-action-dock {
    height: 56px;
    min-height: 56px;
    max-height: 56px;
}

.layout--compact.hub--market .hub-inspector-action-dock .wb-inspector__actions .btn {
    min-height: 42px;
}

.layout--compact .warband-shelf {
    height: 78px;
    min-height: 78px;
}

.layout--compact .warband-shelf__identity,
.layout--compact .warband-shelf__armory {
    height: 64px;
}

.layout--compact .warband-shelf__slots,
.layout--compact .warband-shelf__reserve {
    height: 66px;
}

.layout--compact .party-slot {
    height: 62px;
}

.layout--short .hub-command-ribbon {
    height: 64px;
    min-height: 64px;
}

.layout--short .hub-workspace__body {
    padding-top: 6px;
    padding-bottom: 6px;
}

.layout--short.hub--market .hub-collection__toolbar {
    height: 46px;
    min-height: 46px;
}

.layout--short.hub--market .management-secondary {
    min-height: 36px;
}

.layout--short.hub--market .wb-inspector__overview {
    min-height: 148px;
}

.layout--short.hub--market .wb-inspector--hub .wb-inspector__portrait {
    height: 148px;
    min-height: 148px;
}

.layout--short .warband-shelf {
    height: 70px;
    min-height: 70px;
}

.layout--short .warband-shelf__identity,
.layout--short .warband-shelf__armory {
    height: 58px;
}

.layout--short .warband-shelf__slots,
.layout--short .warband-shelf__reserve {
    height: 60px;
}

.layout--short .party-slot {
    height: 56px;
}

.layout--phone .hub-command-ribbon {
    height: 62px;
    min-height: 62px;
}

.layout--phone .hub-command-ribbon .hub-anchor-rail,
.layout--phone .hub-command-ribbon .management-continue {
    display: none;
}

.layout--phone.hub--market .hub-inspector-slot {
    flex-grow: 1;
}

.layout--phone.hub--market .wb-inspector--hub {
    height: 100%;
}

.layout--phone.hub--market .wb-inspector__content {
    flex-grow: 1;
}
