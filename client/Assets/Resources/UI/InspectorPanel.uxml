<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="inspector" class="wb-inspector panel">
        <ui:Label name="empty" text="Select a card to inspect it." class="wb-inspector__empty" />
        <ui:VisualElement name="content" class="wb-inspector__content">
            <ui:VisualElement name="overview" class="wb-inspector__overview">
                <ui:VisualElement name="portrait" class="wb-inspector__portrait">
                    <ui:Label name="portrait-fallback" class="wb-inspector__portrait-fallback" />
                    <ui:Label name="eyebrow" class="wb-inspector__eyebrow" />
                </ui:VisualElement>
                <ui:VisualElement class="wb-inspector__summary">
                    <ui:VisualElement class="wb-inspector__heading">
                        <ui:VisualElement class="wb-inspector__identity">
                            <ui:Label name="title" class="wb-inspector__title" />
                            <ui:Label name="subtitle" class="wb-inspector__subtitle" />
                        </ui:VisualElement>
                        <ui:VisualElement name="economy" class="wb-inspector__economy">
                            <ui:Label name="price" class="wb-inspector__price" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="detail" class="wb-inspector__detail">
                <ui:VisualElement name="stats" class="wb-inspector__stats" />
                <ui:VisualElement name="targeting" class="wb-targeting">
                    <ui:Label text="TARGETS" class="wb-targeting__label" />
                    <ui:Label name="targeting-value" class="wb-targeting__value" />
                </ui:VisualElement>
                <ui:VisualElement name="rank-up-body" class="wb-rank-up">
                    <ui:VisualElement name="rank-up-gains" class="wb-rank-up__gains" />
                    <ui:VisualElement class="wb-rank-up__tier-row">
                        <ui:Label text="SELECTED TIERS" class="wb-rank-up__label" />
                        <ui:VisualElement name="rank-up-ladder" class="wb-rank-up__ladder" />
                    </ui:VisualElement>
                    <ui:VisualElement class="wb-rank-up__choice-heading">
                        <ui:Label text="SPECIALIZATION · CHOOSE 1 OF 2" class="wb-rank-up__label wb-rank-up__label--choice" />
                        <ui:Label text="Choose after purchase · hover a path for its full rule" class="wb-rank-up__hint" />
                    </ui:VisualElement>
                    <ui:VisualElement name="rank-up-options" class="wb-rank-up__options" />
                </ui:VisualElement>
                <ui:VisualElement name="decision-body" class="wb-inspector__decision-body">
                    <ui:VisualElement name="profile-column" class="wb-inspector__column wb-inspector__column--profile">
                        <ui:VisualElement name="sections" class="wb-inspector__sections" />
                        <ui:VisualElement name="deferred" class="wb-inspector__deferred" />
                        <ui:VisualElement name="path" class="wb-path">
                            <ui:Label text="SPECS" class="wb-path__label" />
                            <ui:VisualElement name="path-rows" class="wb-path__rows" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="equipment-preview" class="wb-equipment-preview">
                        <ui:Label text="PREVIEW ON WARBAND" class="wb-inspector__section-label wb-equipment-preview__label" />
                        <ui:VisualElement name="recipients" class="wb-equipment-preview__recipients" />
                        <ui:Label name="comparison-title" class="wb-equipment-preview__title" />
                        <ui:VisualElement name="comparison-table" class="wb-equipment-preview__comparisons" />
                        <ui:VisualElement name="rule-deltas" class="wb-equipment-preview__rule-deltas" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="tags" class="wb-inspector__tags" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="actions" class="wb-inspector__actions" />
    </ui:VisualElement>
</ui:UXML>
