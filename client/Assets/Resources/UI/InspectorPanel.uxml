<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="inspector" class="wb-inspector panel">
        <ui:Label name="empty" text="Select a card to inspect it." class="wb-inspector__empty" />
        <ui:VisualElement name="content" class="wb-inspector__content">
            <ui:VisualElement class="wb-inspector__overview">
                <ui:VisualElement name="portrait" class="wb-inspector__portrait">
                    <ui:Label name="portrait-fallback" class="wb-inspector__portrait-fallback" />
                    <ui:Label name="eyebrow" class="wb-inspector__eyebrow" />
                </ui:VisualElement>
                <ui:VisualElement class="wb-inspector__summary">
                    <ui:VisualElement class="wb-inspector__heading">
                        <ui:VisualElement class="wb-inspector__identity">
                            <ui:Label name="title" class="wb-inspector__title" />
                            <ui:Label name="subtitle" class="wb-inspector__subtitle" />
                        </ui:VisualElement>
                        <ui:VisualElement name="economy" class="wb-inspector__economy">
                            <ui:Label name="price" class="wb-inspector__price" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="stats" class="wb-inspector__stats" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="sections" class="wb-inspector__sections" />
            <ui:VisualElement name="tags" class="wb-inspector__tags" />
            <ui:VisualElement name="actions" class="wb-inspector__actions" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
