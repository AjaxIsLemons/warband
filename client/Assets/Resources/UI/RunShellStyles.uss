/*
 * Run-shell design system.
 *
 * Palette and panel treatment are lifted from SkirmishStyles.uss on purpose — the shell and the
 * Planning screen must read as one product, not two apps bolted together. Anything already
 * defined there (.panel, .eyebrow, .body-copy, .public-info-pill, .feedback-label) is REUSED and
 * deliberately not redefined here.
 *
 * Layering: tokens -> layout -> type -> controls -> components. Views may only use class names;
 * no view sets colors inline, so a retheme happens here and nowhere else.
 */

/* ---- screens & layout ----------------------------------------------------- */

.shell-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(236, 240, 248);
}

.shell-center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.shell-column {
    flex-direction: column;
}

.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 16px;
    padding-bottom: 16px;
}

.topbar__item {
    flex-direction: row;
    align-items: center;
}

.card-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* ---- opening draft -------------------------------------------------------
 * This is a full-screen decision, not an overlay on the battlefield. The
 * portraits establish identity; the rest of the surface exists to compare
 * five champions comfortably at normal desktop distance.
 */

.recruit-screen {
    background-color: rgb(7, 11, 17);
}

.recruit-header {
    min-height: 154px;
    padding-left: 54px;
    padding-right: 54px;
    padding-top: 30px;
    padding-bottom: 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(83, 103, 133, 0.46);
    background-color: rgba(10, 15, 23, 0.99);
}

.recruit-header__titles {
    flex-grow: 1;
    min-width: 0;
}

.recruit-screen .shell-title {
    margin-bottom: 7px;
    font-size: 44px;
    letter-spacing: 6px;
}

.recruit-screen .shell-subtitle {
    margin-bottom: 0;
    color: rgb(182, 195, 214);
    font-size: 17px;
}

.recruit-header__controls {
    flex-direction: row;
    align-items: center;
    margin-left: 30px;
}

.recruit-seed {
    margin-right: 8px;
    font-size: 11px;
}

.recruit-reroll {
    min-height: 44px;
    margin-right: 14px;
}

.recruit-progress {
    min-width: 132px;
    min-height: 58px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-right: 0;
    padding-left: 18px;
    padding-right: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 117, 153, 0.7);
    border-right-color: rgba(91, 117, 153, 0.7);
    border-top-color: rgba(91, 117, 153, 0.7);
    border-bottom-color: rgba(91, 117, 153, 0.7);
}

.recruit-progress .stat-chip__label {
    margin-right: 0;
    font-size: 10px;
}

.recruit-progress .stat-chip__value {
    margin-top: 2px;
    font-size: 19px;
}

.recruit-screen--ready .recruit-progress {
    background-color: rgba(26, 78, 55, 0.96);
    border-left-color: rgb(100, 215, 150);
    border-right-color: rgb(100, 215, 150);
    border-top-color: rgb(100, 215, 150);
    border-bottom-color: rgb(100, 215, 150);
}

.recruit-card-grid {
    flex-grow: 1;
    flex-wrap: nowrap;
    align-items: center;
    padding-left: 46px;
    padding-right: 46px;
    padding-top: 24px;
    padding-bottom: 24px;
    background-color: rgb(7, 11, 17);
}

/* In-game hover/focus disclosure. It is intentionally pointer-transparent:
 * hover remains owned by the card and keyboard focus gets the same information.
 */
.rules-popover {
    position: absolute;
    width: 430px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    background-color: rgba(9, 14, 22, 0.99);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(116, 175, 246, 0.92);
    border-right-color: rgba(116, 175, 246, 0.92);
    border-top-color: rgba(116, 175, 246, 0.92);
    border-bottom-color: rgba(116, 175, 246, 0.92);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.rules-popover__eyebrow {
    color: rgb(116, 175, 246);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.rules-popover__title {
    margin-top: 3px;
    color: rgb(241, 245, 252);
    font-size: 25px;
    -unity-font-style: bold;
}

.rules-popover__weapon {
    margin-top: 8px;
    color: rgb(198, 210, 228);
    font-size: 14px;
    white-space: normal;
}

.rules-popover__rule {
    margin-top: 12px;
    padding-left: 13px;
    padding-right: 13px;
    padding-top: 10px;
    padding-bottom: 11px;
    background-color: rgba(25, 34, 48, 0.98);
    border-left-width: 3px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.rules-popover__rule--signature {
    border-left-color: rgb(244, 184, 76);
}

.rules-popover__rule--passive {
    border-left-color: rgb(116, 175, 246);
}

.rules-popover__trigger {
    color: rgb(147, 164, 188);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.rules-popover__rule-name {
    margin-top: 3px;
    color: rgb(235, 240, 248);
    font-size: 16px;
    -unity-font-style: bold;
}

.rules-popover__rule-copy {
    margin-top: 3px;
    color: rgb(199, 211, 229);
    font-size: 14px;
    white-space: normal;
}

.rules-popover__keywords {
    margin-top: 12px;
}

.rules-popover__keyword {
    margin-top: 4px;
    color: rgb(164, 181, 205);
    font-size: 12px;
    white-space: normal;
}

.recruit-footer {
    min-height: 112px;
    padding-left: 54px;
    padding-right: 54px;
    padding-top: 20px;
    padding-bottom: 20px;
    border-top-width: 1px;
    border-top-color: rgba(83, 103, 133, 0.46);
    background-color: rgba(10, 15, 23, 0.99);
}

.recruit-footer__hint {
    flex-grow: 1;
    color: rgb(170, 185, 207);
    font-size: 15px;
    white-space: normal;
}

.recruit-begin {
    min-width: 280px;
    min-height: 58px;
    margin-left: 28px;
    font-size: 17px;
}

.recruit-screen--ready .recruit-begin {
    background-color: rgb(47, 112, 189);
    border-left-color: rgb(145, 194, 250);
    border-right-color: rgb(145, 194, 250);
    border-top-color: rgb(145, 194, 250);
    border-bottom-color: rgb(145, 194, 250);
}

/* ---- Muster v2: dedicated opening-draft grammar ---------------------------
 * The starter choice is five equal, direct-select cards. Dense/exact language
 * is progressive disclosure inside the portrait; the card face never grows.
 */

.recruit-screen {
    background-color: rgb(6, 9, 14);
}

.recruit-header {
    min-height: 122px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 22px;
    padding-bottom: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(102, 122, 151, 0.34);
    background-color: rgba(9, 13, 20, 0.99);
}

.recruit-header .shell-title {
    margin-bottom: 5px;
    font-size: 42px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
}

.recruit-header .shell-subtitle {
    margin-bottom: 0;
    color: rgb(174, 189, 210);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.recruit-card-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    padding-left: 42px;
    padding-right: 42px;
    padding-top: 20px;
    padding-bottom: 20px;
    background-color: rgb(6, 9, 14);
}

.warband-glyph {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.muster-card {
    position: relative;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    max-width: 360px;
    height: 100%;
    max-height: 748px;
    margin-left: 6px;
    margin-right: 6px;
    overflow: hidden;
    background-color: rgb(12, 18, 27);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 112, 143, 0.62);
    border-right-color: rgba(91, 112, 143, 0.62);
    border-top-color: rgba(91, 112, 143, 0.62);
    border-bottom-color: rgba(91, 112, 143, 0.62);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    transition-property: scale, translate, border-left-color, border-right-color,
        border-top-color, border-bottom-color, background-color;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.muster-card:hover,
.muster-card:focus {
    translate: 0 -3px;
    scale: 1.012 1.012;
    border-left-color: rgba(151, 181, 222, 0.94);
    border-right-color: rgba(151, 181, 222, 0.94);
    border-top-color: rgba(151, 181, 222, 0.94);
    border-bottom-color: rgba(151, 181, 222, 0.94);
}

.muster-card--selected {
    background-color: rgb(16, 27, 37);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(112, 202, 160);
    border-right-color: rgb(112, 202, 160);
    border-top-color: rgb(112, 202, 160);
    border-bottom-color: rgb(112, 202, 160);
}

.muster-card--blocked {
    border-left-color: rgba(85, 96, 113, 0.62);
    border-right-color: rgba(85, 96, 113, 0.62);
    border-top-color: rgba(85, 96, 113, 0.62);
    border-bottom-color: rgba(85, 96, 113, 0.62);
}

.muster-card__portrait {
    position: relative;
    flex-grow: 11;
    flex-basis: 0;
    min-height: 280px;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(20, 28, 40);
    border-bottom-width: 1px;
    border-bottom-color: rgba(94, 117, 151, 0.55);
}

.muster-card__portrait-fallback {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    color: rgba(205, 216, 232, 0.52);
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.muster-card__role-badge {
    position: absolute;
    left: 13px;
    top: 13px;
    min-height: 31px;
    flex-direction: row;
    align-items: center;
    padding-left: 9px;
    padding-right: 11px;
    background-color: rgba(7, 11, 17, 0.90);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(166, 187, 215, 0.60);
    border-right-color: rgba(166, 187, 215, 0.60);
    border-top-color: rgba(166, 187, 215, 0.60);
    border-bottom-color: rgba(166, 187, 215, 0.60);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    transition-property: opacity;
    transition-duration: 70ms;
    transition-timing-function: ease-out;
}

.muster-card__portrait--lens .muster-card__role-badge {
    opacity: 0;
}

.muster-card__role-icon {
    width: 17px;
    height: 17px;
    margin-right: 7px;
}

.muster-card__role-badge-text {
    color: rgb(224, 232, 243);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.muster-card__info {
    flex-grow: 9;
    flex-basis: 0;
    min-height: 295px;
    padding-left: 13px;
    padding-right: 13px;
    padding-top: 11px;
    padding-bottom: 12px;
    background-color: rgba(11, 17, 26, 0.99);
}

.muster-card__identity {
    min-height: 46px;
    align-items: center;
    justify-content: center;
}

.muster-card__name {
    max-width: 100%;
    overflow: hidden;
    color: rgb(241, 245, 251);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.muster-card__role {
    margin-top: 1px;
    color: rgb(150, 171, 199);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.muster-card__facts {
    height: 66px;
    flex-direction: row;
    margin-top: 7px;
    margin-bottom: 9px;
    background-color: rgb(7, 11, 17);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(73, 93, 120, 0.78);
    border-right-color: rgba(73, 93, 120, 0.78);
    border-top-color: rgba(73, 93, 120, 0.78);
    border-bottom-color: rgba(73, 93, 120, 0.78);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.muster-fact {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 5px;
    padding-right: 5px;
    border-right-width: 1px;
    border-right-color: rgba(73, 93, 120, 0.62);
    transition-property: background-color;
    transition-duration: 90ms;
}

.muster-fact--reach {
    border-right-width: 0;
}

.muster-fact:hover {
    background-color: rgba(45, 67, 94, 0.72);
}

.muster-fact__icon {
    width: 19px;
    height: 19px;
    margin-right: 5px;
}

.muster-fact__value {
    color: rgb(239, 244, 251);
    font-size: 20px;
    -unity-font-style: bold;
}

.muster-fact__secondary-icon {
    width: 15px;
    height: 15px;
    margin-left: 7px;
    margin-right: 3px;
    opacity: 0.78;
}

.muster-fact__secondary-value {
    color: rgb(180, 195, 216);
    font-size: 12px;
    -unity-font-style: bold;
}

.muster-rule {
    min-height: 70px;
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding-left: 11px;
    padding-right: 9px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(22, 31, 44, 0.94);
    border-left-width: 3px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    transition-property: background-color;
    transition-duration: 90ms;
}

.muster-rule:hover {
    background-color: rgba(38, 51, 70, 0.98);
}

.muster-rule--signature {
    border-left-color: rgb(230, 174, 72);
}

.muster-rule--passive {
    border-left-color: rgb(91, 156, 224);
}

.muster-rule__icon {
    width: 23px;
    height: 23px;
    margin-right: 9px;
}

.muster-rule__copy {
    flex-grow: 1;
    min-width: 0;
}

.muster-rule__name {
    max-width: 100%;
    overflow: hidden;
    color: rgb(231, 237, 247);
    font-size: 14px;
    -unity-font-style: bold;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.muster-rule__keyword {
    align-self: flex-start;
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
    padding-left: 6px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(7, 11, 17, 0.82);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.muster-rule__keyword-icon {
    width: 13px;
    height: 13px;
    margin-right: 4px;
}

.muster-rule__keyword-text {
    color: rgb(187, 203, 225);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.muster-rule__context {
    max-width: 78px;
    margin-left: 7px;
    color: rgb(138, 156, 181);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
    -unity-text-align: middle-right;
}

.muster-lens {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    visibility: hidden;
    opacity: 0;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 18px;
    padding-bottom: 16px;
    background-color: rgba(6, 10, 16, 0.965);
    transition-property: opacity;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.muster-lens--visible {
    visibility: visible;
    opacity: 1;
}

.muster-lens__eyebrow {
    color: rgb(222, 174, 83);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.muster-lens__title {
    margin-top: 4px;
    color: rgb(242, 246, 252);
    font-size: 22px;
    -unity-font-style: bold;
    white-space: normal;
}

.muster-lens__context {
    margin-top: 4px;
    color: rgb(126, 174, 225);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.muster-lens__body {
    flex-shrink: 1;
    margin-top: 10px;
    overflow: hidden;
    color: rgb(211, 220, 233);
    font-size: 12px;
    white-space: normal;
}

.muster-lens__keywords {
    flex-shrink: 0;
    margin-top: 8px;
}

.muster-lens__keyword {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 4px;
}

.muster-lens__keyword-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
}

.muster-lens__keyword-copy {
    flex-grow: 1;
    min-width: 0;
    color: rgb(155, 177, 207);
    font-size: 10px;
    white-space: normal;
}

.muster-card__selection {
    position: absolute;
    right: 10px;
    top: 10px;
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 10px;
    background-color: rgb(31, 98, 69);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(117, 224, 168);
    border-right-color: rgb(117, 224, 168);
    border-top-color: rgb(117, 224, 168);
    border-bottom-color: rgb(117, 224, 168);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.muster-card__selection-icon {
    width: 15px;
    height: 15px;
    margin-right: 5px;
}

.muster-card__selection-label {
    color: rgb(229, 249, 238);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.recruit-footer {
    min-height: 128px;
    flex-direction: row;
    align-items: center;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-top-width: 1px;
    border-top-color: rgba(102, 122, 151, 0.36);
    background-color: rgba(9, 13, 20, 0.99);
}

.recruit-party {
    min-width: 270px;
    flex-direction: column;
}

.recruit-party__title {
    margin-bottom: 5px;
    color: rgb(143, 163, 190);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.recruit-party__slots {
    flex-direction: row;
}

.muster-slot {
    position: relative;
    width: 62px;
    height: 62px;
    margin-right: 8px;
    overflow: hidden;
    background-color: rgb(7, 11, 17);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(82, 102, 130, 0.72);
    border-right-color: rgba(82, 102, 130, 0.72);
    border-top-color: rgba(82, 102, 130, 0.72);
    border-bottom-color: rgba(82, 102, 130, 0.72);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.muster-slot--filled {
    border-left-color: rgb(100, 201, 149);
    border-right-color: rgb(100, 201, 149);
    border-top-color: rgb(100, 201, 149);
    border-bottom-color: rgb(100, 201, 149);
}

.muster-slot__portrait {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.muster-slot__fallback {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    color: rgb(202, 216, 233);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.muster-slot__number {
    position: absolute;
    right: 4px;
    bottom: 3px;
    min-width: 17px;
    min-height: 17px;
    color: rgb(173, 189, 211);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(5, 8, 13, 0.88);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.recruit-footer__copy {
    flex-grow: 1;
    min-width: 0;
    margin-left: 18px;
}

.recruit-footer__hint {
    color: rgb(171, 186, 207);
    font-size: 14px;
    white-space: normal;
}

.recruit-feedback {
    margin-top: 4px;
    color: rgb(223, 187, 112);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.recruit-feedback--error {
    color: rgb(238, 130, 119);
}

.recruit-begin {
    position: relative;
    min-width: 270px;
    min-height: 58px;
    overflow: hidden;
    margin-left: 24px;
    font-size: 16px;
}

.recruit-begin__sweep {
    position: absolute;
    left: -90px;
    top: -20px;
    width: 52px;
    height: 110px;
    opacity: 0;
    background-color: rgba(255, 218, 125, 0.50);
    transition-property: translate, opacity;
    transition-duration: 220ms;
    transition-timing-function: ease-out;
}

.recruit-screen--ready-sweep .recruit-begin__sweep {
    translate: 390px 0;
    opacity: 0.80;
}

.recruit-screen--ready .recruit-begin {
    background-color: rgb(142, 102, 35);
    border-left-color: rgb(242, 202, 112);
    border-right-color: rgb(242, 202, 112);
    border-top-color: rgb(242, 202, 112);
    border-bottom-color: rgb(242, 202, 112);
}

.motion--reduced .muster-card:hover,
.motion--reduced .muster-card:focus {
    translate: 0 0;
    scale: 1 1;
}

.motion--reduced .recruit-begin__sweep {
    display: none;
}

.stat-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.trait-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.section-heading {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(150, 166, 190);
    margin-top: 14px;
    margin-bottom: 8px;
}

/* ---- type ----------------------------------------------------------------- */

.shell-title {
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: rgb(238, 243, 252);
    margin-bottom: 6px;
}

.shell-subtitle {
    font-size: 15px;
    color: rgb(150, 166, 190);
    margin-bottom: 26px;
    white-space: normal;
}

.card-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(238, 243, 252);
}

.card-role {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(126, 176, 240);
    margin-top: 2px;
    margin-bottom: 6px;
}

.card-body {
    font-size: 12px;
    color: rgb(186, 197, 214);
    white-space: normal;
}

.empty-note {
    font-size: 12px;
    color: rgb(112, 126, 148);
    -unity-font-style: italic;
    padding-top: 8px;
    padding-bottom: 8px;
}

/* ---- controls ------------------------------------------------------------- */

.btn {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(226, 234, 246);
    background-color: rgba(34, 44, 60, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 117, 153, 0.70);
    border-right-color: rgba(91, 117, 153, 0.70);
    border-top-color: rgba(91, 117, 153, 0.70);
    border-bottom-color: rgba(91, 117, 153, 0.70);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 11px;
    padding-bottom: 11px;
    margin-left: 5px;
    margin-right: 5px;
}

.btn:hover {
    background-color: rgba(48, 62, 84, 0.98);
}

.btn:disabled {
    opacity: 0.4;
}

.btn--primary {
    background-color: rgba(46, 96, 168, 0.96);
    border-left-color: rgba(126, 176, 240, 0.85);
    border-right-color: rgba(126, 176, 240, 0.85);
    border-top-color: rgba(126, 176, 240, 0.85);
    border-bottom-color: rgba(126, 176, 240, 0.85);
}

.btn--primary:hover {
    background-color: rgba(60, 118, 198, 0.98);
}

.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(158, 172, 194);
}

.btn--danger {
    background-color: rgba(140, 48, 44, 0.94);
    border-left-color: rgba(226, 108, 96, 0.8);
    border-right-color: rgba(226, 108, 96, 0.8);
    border-top-color: rgba(226, 108, 96, 0.8);
    border-bottom-color: rgba(226, 108, 96, 0.8);
}

/* ---- cards ---------------------------------------------------------------- */

.card {
    width: 232px;
    background-color: rgba(16, 21, 30, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 117, 153, 0.55);
    border-right-color: rgba(91, 117, 153, 0.55);
    border-top-color: rgba(91, 117, 153, 0.55);
    border-bottom-color: rgba(91, 117, 153, 0.55);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 13px;
    padding-bottom: 13px;
    margin-left: 7px;
    margin-right: 7px;
    margin-top: 7px;
    margin-bottom: 7px;
}

.card:hover {
    border-left-color: rgba(126, 176, 240, 0.8);
    border-right-color: rgba(126, 176, 240, 0.8);
    border-top-color: rgba(126, 176, 240, 0.8);
    border-bottom-color: rgba(126, 176, 240, 0.8);
}

.card--selected {
    background-color: rgba(28, 52, 86, 0.97);
    border-left-color: rgb(126, 176, 240);
    border-right-color: rgb(126, 176, 240);
    border-top-color: rgb(126, 176, 240);
    border-bottom-color: rgb(126, 176, 240);
}

.card--disabled {
    opacity: 0.45;
}

/* ---- chips ---------------------------------------------------------------- */

.stat-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(34, 44, 60, 0.9);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-right: 5px;
    margin-bottom: 4px;
}

.stat-chip__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(140, 156, 180);
    margin-right: 5px;
}

.stat-chip__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(232, 238, 248);
}

.stat-chip--good .stat-chip__value { color: rgb(126, 214, 150); }
.stat-chip--bad  .stat-chip__value { color: rgb(230, 120, 108); }
.stat-chip--warn .stat-chip__value { color: rgb(232, 186, 108); }

.trait-pill {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(186, 168, 224);
    background-color: rgba(58, 46, 88, 0.85);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.gold-pill {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(238, 200, 116);
    background-color: rgba(58, 46, 20, 0.9);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 5px;
    padding-bottom: 5px;
}

/* ---- act track ------------------------------------------------------------ */

.track {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

.track-node {
    width: 96px;
    align-items: center;
    background-color: rgba(16, 21, 30, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 117, 153, 0.45);
    border-right-color: rgba(91, 117, 153, 0.45);
    border-top-color: rgba(91, 117, 153, 0.45);
    border-bottom-color: rgba(91, 117, 153, 0.45);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-left: 4px;
    margin-right: 4px;
}

.track-node--past {
    opacity: 0.42;
}

.track-node--current {
    background-color: rgba(28, 52, 86, 0.97);
    border-left-color: rgb(126, 176, 240);
    border-right-color: rgb(126, 176, 240);
    border-top-color: rgb(126, 176, 240);
    border-bottom-color: rgb(126, 176, 240);
    scale: 1.06 1.06;
}

.track-node--boss {
    border-left-color: rgba(226, 108, 96, 0.85);
    border-right-color: rgba(226, 108, 96, 0.85);
    border-top-color: rgba(226, 108, 96, 0.85);
    border-bottom-color: rgba(226, 108, 96, 0.85);
}

/* ---- wager tiers ---------------------------------------------------------- */

.tier-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 10px;
}

.tier-card {
    width: 168px;
    background-color: rgba(16, 21, 30, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 117, 153, 0.5);
    border-right-color: rgba(91, 117, 153, 0.5);
    border-top-color: rgba(91, 117, 153, 0.5);
    border-bottom-color: rgba(91, 117, 153, 0.5);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    padding-left: 13px;
    padding-right: 13px;
    padding-top: 11px;
    padding-bottom: 11px;
    margin-left: 6px;
    margin-right: 6px;
}

.tier-card--selected {
    background-color: rgba(28, 52, 86, 0.97);
    border-left-color: rgb(126, 176, 240);
    border-right-color: rgb(126, 176, 240);
    border-top-color: rgb(126, 176, 240);
    border-bottom-color: rgb(126, 176, 240);
}

/* ---- modal ---------------------------------------------------------------- */

.modal-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 10, 0.78);
    align-items: center;
    justify-content: center;
}

.modal {
    width: 560px;
    background-color: rgba(13, 17, 24, 0.99);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(126, 176, 240);
    border-right-color: rgb(126, 176, 240);
    border-top-color: rgb(126, 176, 240);
    border-bottom-color: rgb(126, 176, 240);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 22px;
    padding-bottom: 22px;
}

/* ---- outcome -------------------------------------------------------------- */

.outcome-heading {
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 7px;
    margin-bottom: 8px;
}

.outcome--victory { color: rgb(238, 200, 116); }
.outcome--defeat  { color: rgb(226, 108, 96); }

/* ---- fight overlay --------------------------------------------------------
 * The board is the screen during a fight, so this is intentionally almost
 * nothing: a corner escape hatch that can never occlude the fight itself.
 */

.fight-overlay {
    position: absolute;
    right: 22px;
    bottom: 22px;
    flex-direction: row;
}

/* ---- inherited toast, re-anchored -----------------------------------------
 * `.feedback-label` is shared with the Planning screen, where `bottom: 374px`
 * clears the Muster Drawer. No shell screen has that drawer, so the same offset
 * would strand the message mid-screen. Override the anchor ONLY — the accent
 * border and colours stay shared, which is the point of reusing the class.
 */

.shell-screen .feedback-label {
    bottom: 92px;
}

/* ---- deployment -----------------------------------------------------------
 * The board is the screen: panels hug the edges and the middle stays clear so
 * the player can see the hexes they are clicking.
 */

.deploy-header {
    position: absolute;
    left: 24px;
    top: 22px;
    width: 430px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.deploy-rail {
    position: absolute;
    left: 24px;
    top: 150px;
    width: 250px;
    max-height: 620px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 12px;
}

.deploy-enemy {
    position: absolute;
    right: 24px;
    top: 22px;
    width: 330px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 13px;
    padding-bottom: 14px;
}

.deploy-bar {
    position: absolute;
    right: 24px;
    bottom: 24px;
    flex-direction: row;
    align-items: center;
}

.deploy-chip {
    width: auto;
    margin-left: 0;
    margin-right: 0;
    padding-top: 9px;
    padding-bottom: 9px;
}

/* Placed reads as settled, not unavailable — it can still be picked up. */
.deploy-chip--placed {
    opacity: 0.72;
}
