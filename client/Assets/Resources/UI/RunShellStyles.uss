/*
 * Run-shell design system.
 *
 * Palette and panel treatment are lifted from SkirmishStyles.uss on purpose — the shell and the
 * Planning screen must read as one product, not two apps bolted together. Anything already
 * defined there (.panel, .eyebrow, .body-copy, .public-info-pill) is REUSED and
 * deliberately not redefined here.
 *
 * Layering: tokens -> layout -> type -> controls -> components. Views may only use class names;
 * no view sets colors inline, so a retheme happens here and nowhere else.
 */

/* ---- screens & layout ----------------------------------------------------- */

.shell-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(236, 240, 248);
}

.shell-center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.shell-column {
    flex-direction: column;
}

/* ---- First Draft: the run's temporal law -------------------------------- */

.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 16px;
    padding-bottom: 16px;
}

.topbar__item {
    flex-direction: row;
    align-items: center;
}

.card-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* In-game hover/focus disclosure. It is intentionally pointer-transparent:
 * hover remains owned by the card and keyboard focus gets the same information.
 */
.rules-popover {
    position: absolute;
    width: 430px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    background-color: rgba(9, 14, 22, 0.99);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(116, 175, 246, 0.92);
    border-right-color: rgba(116, 175, 246, 0.92);
    border-top-color: rgba(116, 175, 246, 0.92);
    border-bottom-color: rgba(116, 175, 246, 0.92);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.rules-popover__eyebrow {
    color: rgb(116, 175, 246);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.rules-popover__title {
    margin-top: 3px;
    color: rgb(241, 245, 252);
    font-size: 25px;
    -unity-font-style: bold;
}

.rules-popover__weapon {
    margin-top: 8px;
    color: rgb(198, 210, 228);
    font-size: 14px;
    white-space: normal;
}

.rules-popover__rule {
    margin-top: 12px;
    padding-left: 13px;
    padding-right: 13px;
    padding-top: 10px;
    padding-bottom: 11px;
    background-color: rgba(25, 34, 48, 0.98);
    border-left-width: 3px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.rules-popover__rule--signature {
    border-left-color: rgb(244, 184, 76);
}

.rules-popover__rule--passive {
    border-left-color: rgb(116, 175, 246);
}

.rules-popover__trigger {
    color: rgb(147, 164, 188);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.rules-popover__rule-name {
    margin-top: 3px;
    color: rgb(235, 240, 248);
    font-size: 16px;
    -unity-font-style: bold;
}

.rules-popover__rule-copy {
    margin-top: 3px;
    color: rgb(199, 211, 229);
    font-size: 14px;
    white-space: normal;
}

.rules-popover__keywords {
    margin-top: 12px;
}

.rules-popover__keyword {
    margin-top: 4px;
    color: rgb(164, 181, 205);
    font-size: 12px;
    white-space: normal;
}

.warband-glyph {
    width: 20px;
    height: 20px;
}

/* NOTE (2026-07-28, workbench-frame session): the .layout--phone overrides for the
 * revision-combat overlay (and a lone .revision-clock__outer refinement) were lost in
 * a stylesheet-editing accident this session; their base desktop rules are intact.
 * Re-tune the phone trims at the next phone-layout pass. */

.stat-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.trait-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.section-heading {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(150, 166, 190);
    margin-top: 14px;
    margin-bottom: 8px;
}

/* ---- type ----------------------------------------------------------------- */

.shell-title {
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: rgb(238, 243, 252);
    margin-bottom: 6px;
}

.shell-subtitle {
    font-size: 15px;
    color: rgb(150, 166, 190);
    margin-bottom: 26px;
    white-space: normal;
}

.card-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(238, 243, 252);
}

.card-role {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(126, 176, 240);
    margin-top: 2px;
    margin-bottom: 6px;
}

.card-body {
    font-size: 12px;
    color: rgb(186, 197, 214);
    white-space: normal;
}

.empty-note {
    font-size: 12px;
    color: rgb(112, 126, 148);
    -unity-font-style: italic;
    padding-top: 8px;
    padding-bottom: 8px;
}

/* ---- controls ------------------------------------------------------------- */

.btn {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(226, 234, 246);
    background-color: rgba(34, 44, 60, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 117, 153, 0.70);
    border-right-color: rgba(91, 117, 153, 0.70);
    border-top-color: rgba(91, 117, 153, 0.70);
    border-bottom-color: rgba(91, 117, 153, 0.70);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 11px;
    padding-bottom: 11px;
    margin-left: 5px;
    margin-right: 5px;
}

.btn:hover {
    background-color: rgba(48, 62, 84, 0.98);
}

.btn:disabled {
    opacity: 0.4;
}

.btn--primary {
    background-color: rgba(46, 96, 168, 0.96);
    border-left-color: rgba(126, 176, 240, 0.85);
    border-right-color: rgba(126, 176, 240, 0.85);
    border-top-color: rgba(126, 176, 240, 0.85);
    border-bottom-color: rgba(126, 176, 240, 0.85);
}

.btn--primary:hover {
    background-color: rgba(60, 118, 198, 0.98);
}

.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(158, 172, 194);
}

.btn--danger {
    background-color: rgba(140, 48, 44, 0.94);
    border-left-color: rgba(226, 108, 96, 0.8);
    border-right-color: rgba(226, 108, 96, 0.8);
    border-top-color: rgba(226, 108, 96, 0.8);
    border-bottom-color: rgba(226, 108, 96, 0.8);
}

/* ---- cards ---------------------------------------------------------------- */

.card {
    width: 232px;
    background-color: rgba(16, 21, 30, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 117, 153, 0.55);
    border-right-color: rgba(91, 117, 153, 0.55);
    border-top-color: rgba(91, 117, 153, 0.55);
    border-bottom-color: rgba(91, 117, 153, 0.55);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 13px;
    padding-bottom: 13px;
    margin-left: 7px;
    margin-right: 7px;
    margin-top: 7px;
    margin-bottom: 7px;
}

.card:hover {
    border-left-color: rgba(126, 176, 240, 0.8);
    border-right-color: rgba(126, 176, 240, 0.8);
    border-top-color: rgba(126, 176, 240, 0.8);
    border-bottom-color: rgba(126, 176, 240, 0.8);
}

.card--selected {
    background-color: rgba(28, 52, 86, 0.97);
    border-left-color: rgb(126, 176, 240);
    border-right-color: rgb(126, 176, 240);
    border-top-color: rgb(126, 176, 240);
    border-bottom-color: rgb(126, 176, 240);
}

.card--disabled {
    opacity: 0.45;
}

/* ---- chips ---------------------------------------------------------------- */

.stat-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(34, 44, 60, 0.9);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-right: 5px;
    margin-bottom: 4px;
}

.stat-chip__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(140, 156, 180);
    margin-right: 5px;
}

.stat-chip__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(232, 238, 248);
}

.stat-chip--good .stat-chip__value {
    color: rgb(126, 214, 150);
}

.stat-chip--bad  .stat-chip__value {
    color: rgb(230, 120, 108);
}

.stat-chip--warn .stat-chip__value {
    color: rgb(232, 186, 108);
}

.trait-pill {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(186, 168, 224);
    background-color: rgba(58, 46, 88, 0.85);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.gold-pill {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(238, 200, 116);
    background-color: rgba(58, 46, 20, 0.9);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 5px;
    padding-bottom: 5px;
}

/* ---- act track ------------------------------------------------------------ */

.track {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

.track-node {
    width: 96px;
    align-items: center;
    background-color: rgba(16, 21, 30, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 117, 153, 0.45);
    border-right-color: rgba(91, 117, 153, 0.45);
    border-top-color: rgba(91, 117, 153, 0.45);
    border-bottom-color: rgba(91, 117, 153, 0.45);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-left: 4px;
    margin-right: 4px;
}

.track-node--past {
    opacity: 0.42;
}

.track-node--current {
    background-color: rgba(28, 52, 86, 0.97);
    border-left-color: rgb(126, 176, 240);
    border-right-color: rgb(126, 176, 240);
    border-top-color: rgb(126, 176, 240);
    border-bottom-color: rgb(126, 176, 240);
    scale: 1.06 1.06;
}

.track-node--boss {
    border-left-color: rgba(226, 108, 96, 0.85);
    border-right-color: rgba(226, 108, 96, 0.85);
    border-top-color: rgba(226, 108, 96, 0.85);
    border-bottom-color: rgba(226, 108, 96, 0.85);
}

/* ---- wager tiers ---------------------------------------------------------- */

.tier-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 10px;
}

.tier-card {
    width: 168px;
    background-color: rgba(16, 21, 30, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 117, 153, 0.5);
    border-right-color: rgba(91, 117, 153, 0.5);
    border-top-color: rgba(91, 117, 153, 0.5);
    border-bottom-color: rgba(91, 117, 153, 0.5);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    padding-left: 13px;
    padding-right: 13px;
    padding-top: 11px;
    padding-bottom: 11px;
    margin-left: 6px;
    margin-right: 6px;
}

.tier-card--selected {
    background-color: rgba(28, 52, 86, 0.97);
    border-left-color: rgb(126, 176, 240);
    border-right-color: rgb(126, 176, 240);
    border-top-color: rgb(126, 176, 240);
    border-bottom-color: rgb(126, 176, 240);
}

/* ---- modal ---------------------------------------------------------------- */

.modal-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 10, 0.78);
    align-items: center;
    justify-content: center;
}

.modal {
    width: 560px;
    background-color: rgba(13, 17, 24, 0.99);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(126, 176, 240);
    border-right-color: rgb(126, 176, 240);
    border-top-color: rgb(126, 176, 240);
    border-bottom-color: rgb(126, 176, 240);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 22px;
    padding-bottom: 22px;
}

/* ---- outcome -------------------------------------------------------------- */

.outcome-heading {
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 7px;
    margin-bottom: 8px;
}

.outcome--victory {
    color: rgb(238, 200, 116);
}

.outcome--defeat {
    color: rgb(226, 108, 96);
}

/* ---- fight overlay --------------------------------------------------------
 * The board is the screen during a fight, so this is intentionally almost
 * nothing: a corner escape hatch that can never occlude the fight itself.
 */

.fight-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- Revision: held Hour + branch instrument ----------------------------- */

.revision-combat {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.revision-combat__instrument {
    position: absolute;
    left: 50%;
    bottom: 20px;
    width: 760px;
    translate: -380px 0;
    align-items: center;
}

.revision-combat--selecting.revision-combat--dock-top .revision-combat__instrument {
    top: 20px;
    bottom: auto;
}

.revision-ceremony__backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(3, 5, 10);
}

.revision-clock {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 310px;
    height: 310px;
    margin-left: -155px;
    margin-top: -155px;
    align-items: center;
    justify-content: center;
}

.revision-clock__outer,
.revision-clock__inner,
.revision-clock__pulse {
    position: absolute;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(224, 198, 139, 0.78);
    border-right-color: rgba(224, 198, 139, 0.78);
    border-top-color: rgba(224, 198, 139, 0.78);
    border-bottom-color: rgba(224, 198, 139, 0.78);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.revision-clock__inner {
    width: 238px;
    height: 238px;
    border-left-color: rgba(224, 198, 139, 0.34);
    border-right-color: rgba(224, 198, 139, 0.34);
    border-top-color: rgba(224, 198, 139, 0.34);
    border-bottom-color: rgba(224, 198, 139, 0.34);
}
.revision-clock__pulse {
    width: 276px;
    height: 276px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgba(244, 213, 145, 0.82);
    border-right-color: rgba(244, 213, 145, 0.82);
    border-top-color: rgba(244, 213, 145, 0.82);
    border-bottom-color: rgba(244, 213, 145, 0.82);
}

.revision-clock__hand {
    position: absolute;
    left: 50%;
    top: 50%;
    background-color: rgb(235, 207, 146);
}

.revision-clock__hand--long {
    width: 3px;
    height: 112px;
    margin-left: -1px;
    margin-top: -112px;
}

.revision-clock__hand--short {
    width: 78px;
    height: 3px;
    margin-top: -1px;
}

.revision-ceremony__copy {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 182px;
    align-items: center;
}

.revision-ceremony__title {
    color: rgb(243, 218, 164);
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 9px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 18px rgba(240, 203, 130, 0.55);
}

.revision-ceremony__subtitle {
    margin-top: 8px;
    color: rgb(169, 184, 202);
    font-size: 12px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.revision-receipt {
    width: 700px;
    min-height: 290px;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 30px;
    padding-bottom: 30px;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 11, 18, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(227, 198, 132);
    border-right-color: rgb(227, 198, 132);
    border-top-color: rgb(227, 198, 132);
    border-bottom-color: rgb(227, 198, 132);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.revision-receipt__eyebrow {
    color: rgb(153, 174, 199);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.revision-receipt__title {
    margin-top: 7px;
    color: rgb(247, 223, 168);
    font-size: 36px;
    -unity-font-style: bold;
    letter-spacing: 7px;
    -unity-text-align: middle-center;
}

.revision-receipt__subtitle {
    margin-top: 4px;
    color: rgb(126, 167, 202);
    font-size: 11px;
    letter-spacing: 3px;
}

.revision-receipt__lines {
    width: 100%;
    margin-top: 22px;
}

.revision-receipt__line {
    min-height: 31px;
    padding-top: 6px;
    padding-bottom: 6px;
    color: rgb(231, 238, 247);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    border-top-width: 1px;
    border-top-color: rgba(111, 142, 177, 0.3);
}

.revision-combat__ready {
    min-width: 390px;
    min-height: 66px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 18px;
    padding-right: 8px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgba(7, 12, 20, 0.91);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(116, 184, 231, 0.72);
    border-right-color: rgba(116, 184, 231, 0.72);
    border-top-color: rgba(116, 184, 231, 0.72);
    border-bottom-color: rgba(116, 184, 231, 0.72);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.revision-combat__ready-copy {
    margin-right: 18px;
}

.revision-combat__name {
    color: rgb(226, 237, 249);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.revision-combat__charge {
    margin-top: 2px;
    color: rgb(118, 160, 202);
    font-size: 10px;
    letter-spacing: 2px;
}

.revision-combat__revise,
.revision-combat__confirm {
    min-height: 44px;
    padding-left: 18px;
    padding-right: 18px;
    color: rgb(239, 247, 255);
    background-color: rgb(32, 95, 139);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(126, 204, 247);
    border-right-color: rgb(126, 204, 247);
    border-top-color: rgb(126, 204, 247);
    border-bottom-color: rgb(126, 204, 247);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* =========================================================================
   The Hourstone — approved 2026-07-29 (ui-review revision-time-toy, sample
   b-r3-*). The docked two-column draft panel, the landmark rail, the price
   row and the readout are gone: the board is the record, so the only chrome
   is a stone you turn and the ability drawn on the unit it happens to.
   ========================================================================= */

.revision-dial {
    position: absolute;
    left: 50%;
    bottom: -148px;
    margin-left: -194px;
    width: 388px;
    height: 388px;
    border-radius: 194px;
    background-color: rgba(6, 11, 18, 0.94);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgba(150, 120, 70, 0.6);
    border-right-color: rgba(150, 120, 70, 0.6);
    border-top-color: rgba(233, 181, 95, 0.85);
    border-bottom-color: rgba(150, 120, 70, 0.6);
}

.revision-combat--final .revision-dial {
    border-top-color: rgb(240, 226, 200);
    border-left-color: rgba(196, 176, 140, 0.7);
    border-right-color: rgba(196, 176, 140, 0.7);
}

.revision-dial__fill,
.revision-dial__notches {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* UI Toolkit has no conic gradient, so the hold fill is a run of beads that light in order. */
.revision-dial__sand {
    position: absolute;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: rgba(233, 181, 95, 0.20);
}

.revision-dial__sand--lit {
    background-color: rgb(255, 231, 188);
}

.revision-dial__notch {
    position: absolute;
    width: 54px;
    height: 54px;
    margin-left: -27px;
    margin-top: -27px;
    min-width: 0;
    min-height: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-right: 0;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    align-items: center;
    justify-content: flex-start;
}

/* The visible mark. It is deliberately small; the 54px parent is what you actually click. */
.revision-dial__bead {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 10px;
    flex-shrink: 0;
    background-color: rgb(216, 232, 248);
}

.revision-dial__notch--selected .revision-dial__bead {
    background-color: rgb(255, 230, 176);
}

.revision-dial__notch:hover .revision-dial__bead {
    background-color: rgb(255, 246, 222);
}

.revision-dial__notch-label {
    position: absolute;
    left: 50%;
    top: 16px;
    width: 38px;
    margin-left: -19px;
    -unity-text-align: upper-center;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(198, 168, 118);
}

.revision-dial__notch--selected .revision-dial__notch-label {
    color: rgb(255, 233, 188);
    font-size: 15px;
}

.revision-dial__knob {
    position: absolute;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    margin-top: -20px;
    border-radius: 20px;
    background-color: rgb(233, 181, 95);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 246, 222, 0.9);
    border-right-color: rgba(255, 246, 222, 0.9);
    border-top-color: rgba(255, 246, 222, 0.9);
    border-bottom-color: rgba(255, 246, 222, 0.9);
}

.revision-dial--holding .revision-dial__knob {
    background-color: rgb(255, 240, 205);
}

.revision-dial__lineage {
    position: absolute;
    left: 0;
    right: 0;
    top: -34px;
    -unity-text-align: upper-center;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: rgb(233, 181, 95);
}

.revision-dial__eye {
    position: absolute;
    left: 50%;
    top: 80px;
    width: 275px;
    margin-left: -138px;
    align-items: center;
}

.revision-dial__number {
    font-size: 78px;
    -unity-font-style: bold;
    letter-spacing: -4px;
    color: rgb(255, 233, 188);
}

.revision-dial__sub {
    margin-top: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(217, 190, 138);
}

.revision-dial__hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 254px;
    -unity-text-align: upper-center;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(198, 168, 118);
}

.revision-combat--final .revision-dial__hint {
    color: rgb(240, 214, 160);
}

/* ---- the ability, drawn on the unit it happens to ---- */

.revision-cluster {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.revision-cluster__carry {
    position: absolute;
    width: 262px;
    margin-left: -131px;
    -unity-text-align: upper-center;
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: -2px;
    color: rgb(143, 227, 255);
}

.revision-cluster__orb {
    position: absolute;
    width: 82px;
    height: 82px;
    margin-left: -41px;
    margin-top: -41px;
    border-radius: 41px;
    background-color: rgb(95, 208, 255);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(205, 242, 255, 0.95);
    border-right-color: rgba(205, 242, 255, 0.95);
    border-top-color: rgba(205, 242, 255, 0.95);
    border-bottom-color: rgba(205, 242, 255, 0.95);
    align-items: center;
    justify-content: center;
}

.revision-cluster__orb-value {
    font-size: 25px;
    -unity-font-style: bold;
    color: rgb(6, 34, 47);
}

.revision-cluster__orb-label {
    position: absolute;
    width: 188px;
    margin-left: -94px;
    -unity-text-align: upper-center;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(191, 231, 255);
}

/* Mana caps; the remainder becomes Shield. The ring breaking out of the orb IS that rule. */
.revision-cluster__spill {
    position: absolute;
    width: 122px;
    height: 122px;
    margin-left: -61px;
    margin-top: -61px;
    border-radius: 61px;
    border-left-width: 7px;
    border-right-width: 7px;
    border-top-width: 7px;
    border-bottom-width: 7px;
    border-left-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-color: rgb(246, 250, 255);
    border-right-color: rgb(246, 250, 255);
}

.revision-cluster__spill-value {
    position: absolute;
    width: 150px;
    margin-left: -12px;
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
}

.revision-cluster__tether {
    position: absolute;
    height: 5px;
    border-radius: 2px;
    background-color: rgba(255, 156, 140, 0.95);
}

.revision-cluster__home {
    position: absolute;
    width: 122px;
    height: 61px;
    margin-left: -61px;
    margin-top: -31px;
    border-radius: 61px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(255, 186, 172, 0.98);
    border-right-color: rgba(255, 186, 172, 0.98);
    border-top-color: rgba(255, 186, 172, 0.98);
    border-bottom-color: rgba(255, 186, 172, 0.98);
    align-items: center;
    justify-content: center;
}

.revision-cluster__home-ghost {
    width: 60px;
    height: 48px;
    border-radius: 30px;
    background-color: rgba(255, 178, 164, 0.34);
}

.revision-cluster__disarm {
    position: absolute;
    width: 262px;
    margin-left: -131px;
    -unity-text-align: upper-center;
    font-size: 65px;
    -unity-font-style: bold;
    letter-spacing: -2px;
    color: rgb(255, 156, 140);
}

.revision-cluster__disarm-label {
    position: absolute;
    width: 262px;
    margin-left: -131px;
    -unity-text-align: upper-center;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(255, 211, 202);
}


.fight-skip,
.fight-options {
    position: absolute;
    bottom: 22px;
}

.fight-skip {
    right: 22px;
}

.fight-options {
    right: 112px;
}

.layout--phone .revision-combat__instrument {
    bottom: 8px;
    width: 600px;
    translate: -300px 0;
}

.layout--phone .revision-combat--selecting.revision-combat--dock-top .revision-combat__instrument {
    top: 8px;
    bottom: auto;
}

.layout--phone .revision-combat__ready {
    min-height: 50px;
}


.layout--phone .revision-clock {
    width: 230px;
    height: 230px;
    margin-left: -115px;
    margin-top: -130px;
}

/* ---- deployment -----------------------------------------------------------
 * The board is the screen: panels hug the edges and the middle stays clear so
 * the player can see the hexes they are clicking.
 */

.deploy-header {
    position: absolute;
    left: 24px;
    top: 22px;
    width: 430px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.deploy-rail {
    position: absolute;
    left: 24px;
    top: 150px;
    width: 250px;
    max-height: 620px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 12px;
}

.deploy-enemy {
    position: absolute;
    right: 24px;
    top: 22px;
    width: 330px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 13px;
    padding-bottom: 14px;
}

.deploy-bar {
    position: absolute;
    right: 24px;
    bottom: 24px;
    flex-direction: row;
    align-items: center;
}

.deploy-chip {
    width: auto;
    margin-left: 0;
    margin-right: 0;
    padding-top: 9px;
    padding-bottom: 9px;
}

/* Placed reads as settled, not unavailable — it can still be picked up. */
.deploy-chip--placed {
    opacity: 0.72;
}

/* Shipping type floor. Recruit is a decision surface, so its explanatory copy uses the shared
   body role and its labels use the shared metadata role. Decorative glyphs keep their authored
   sizes; information never drops below these tokens at compact breakpoints. */

.options-modal {
    width: 520px;
    max-width: 90%;
}

.options-modal__heading {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(226, 234, 246);
    margin-bottom: 6px;
}

.options-modal__section {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgb(158, 172, 194);
    margin-top: 14px;
    margin-bottom: 4px;
}

.options-modal__row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.options-modal__label {
    width: 130px;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(200, 210, 226);
    flex-shrink: 0;
}

.options-modal__slider {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 10px;
}

.options-modal__value {
    width: 52px;
    font-size: 13px;
    color: rgb(226, 234, 246);
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.options-modal__toggle {
    margin-top: 2px;
    color: rgb(200, 210, 226);
    font-size: 13px;
    letter-spacing: 1px;
}

.options-modal__hint {
    font-size: 11px;
    color: rgb(122, 136, 158);
    margin-bottom: 2px;
    white-space: normal;
}

.options-modal__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 16px;
    flex-shrink: 0;
}
