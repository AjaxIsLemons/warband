/* THE COMBAT RECAP (roadmap item 1c) — the three charts on the result gate.
 *
 * ⚠ THE BUG THIS FILE EXISTS TO NOT REPEAT (2026-07-27, caught by Jake in a real fight):
 * every element in UI Toolkit defaults to `flex-shrink: 1`. The result gate is capped at
 * `max-height: 94%` of a 900px reference viewport, so when the recap pushed the content past
 * that budget, Yoga did not clip or scroll — it SILENTLY SQUASHED every child. 22px rows
 * resolved to ~11px, their 14px text overflowed the box, and even the pre-existing stat cards
 * spilled their values outside their own background. Nothing errored. It just became unreadable.
 *
 * So: everything with a fixed height here is `flex-shrink: 0`. Overflow must present as honest
 * overflow that UiLayoutContract.RequireMinimumHeight can FAIL on, never as a silent squash.
 * Height is the scarce axis and width is abundant (1757x900 reference at Jake's 2543x1302), which
 * is why composition and timeline sit side by side rather than stacked.
 *
 * Palette note: cause colour lives HERE and only here. Sim-side LexKind is deliberately not a
 * colour (see Lexicon docs — battlefield colour is owned by the signature-matched tells in
 * tuning.json), so the chart picks its own hues in the UI layer. */

.recap {
    margin-top: 6px;
    flex-shrink: 0;
}

.recap__section {
    margin-bottom: 6px;
    flex-shrink: 0;
}

.recap__title {
    color: rgb(139, 158, 184);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.recap__empty {
    color: rgb(120, 136, 160);
    font-size: 14px;
}

/* Composition and timeline share a row: each is short and neither needs the full 892px. */
.recap__split {
    flex-direction: row;
    flex-shrink: 0;
}

.recap__col {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 0;
    margin-bottom: 0;
}

/* Wider than the timeline so a five-cause legend stays on ONE line — a wrapped legend cost
 * ~18px of the exact height this panel does not have. */
.recap__col--first {
    flex-grow: 1.4;
    margin-right: 24px;
}

/* ---- ① contribution ------------------------------------------------------------------ */

/* The name label carries an EXPLICIT height. Without it, its own `overflow: hidden` (which the
 * ellipsis needs) clipped the descenders — "Vigil" lost the tail of its g. Long names must
 * truncate horizontally, never vertically. */
.recap-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 1px;
    height: 22px;
    min-height: 22px;
    flex-shrink: 0;
}

.recap-row__name {
    width: 150px;
    height: 20px;
    flex-shrink: 0;
    color: rgb(214, 226, 242);
    font-size: 14px;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}

.recap-row--dead .recap-row__name {
    color: rgb(146, 156, 172);
}

/* A fallen hero keeps its bar — it earned that damage — but is marked as gone. */
.recap-row__dagger {
    width: 14px;
    flex-shrink: 0;
    color: rgb(224, 98, 104);
    font-size: 13px;
}

.recap-row__track {
    flex-grow: 1;
    flex-shrink: 1;
    height: 12px;
    min-height: 12px;
    background-color: rgba(14, 21, 32, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(90, 112, 142, 0.35);
    border-right-color: rgba(90, 112, 142, 0.35);
    border-top-color: rgba(90, 112, 142, 0.35);
    border-bottom-color: rgba(90, 112, 142, 0.35);
}

.recap-row__fill {
    height: 100%;
    background-color: rgb(116, 175, 246);
}

.recap-row--dead .recap-row__fill {
    background-color: rgb(94, 126, 168);
}

.recap-row__value {
    width: 104px;
    flex-shrink: 0;
    margin-left: 10px;
    -unity-text-align: middle-right;
    color: rgb(239, 244, 251);
    font-size: 14px;
    -unity-font-style: bold;
}

.recap-row__sub {
    width: 104px;
    flex-shrink: 0;
    margin-left: 8px;
    -unity-text-align: middle-right;
    color: rgb(139, 158, 184);
    font-size: 12px;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}

/* ---- ② composition ------------------------------------------------------------------- */

.recap-comp {
    flex-direction: row;
    height: 16px;
    min-height: 16px;
    flex-shrink: 0;
    background-color: rgba(14, 21, 32, 0.9);
}

.recap-comp__seg {
    height: 100%;
    background-color: rgb(110, 124, 146);
}

.recap-comp__legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
    flex-shrink: 0;
}

.recap-key {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
    height: 18px;
    min-height: 18px;
    flex-shrink: 0;
}

.recap-key__swatch {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    margin-right: 6px;
    background-color: rgb(110, 124, 146);
}

.recap-key__label {
    color: rgb(196, 210, 230);
    font-size: 13px;
}

.cause--attack { background-color: rgb(116, 175, 246); }
.cause--ability { background-color: rgb(178, 138, 246); }
.cause--dot { background-color: rgb(126, 196, 142); }
.cause--burn { background-color: rgb(244, 146, 76); }
.cause--field { background-color: rgb(96, 196, 204); }
.cause--trigger { background-color: rgb(244, 184, 76); }
.cause--counter { background-color: rgb(224, 140, 150); }
.cause--storm { background-color: rgb(150, 166, 190); }

/* ---- ③ timeline ---------------------------------------------------------------------- */

.recap-track {
    height: 22px;
    min-height: 22px;
    flex-shrink: 0;
    background-color: rgba(14, 21, 32, 0.9);
    border-bottom-width: 1px;
    border-bottom-color: rgba(90, 112, 142, 0.5);
}

/* Markers are absolutely placed by percentage, so the track is the fight's clock: ours drop
 * below the midline, theirs sit above it, and the eye reads the trade at a glance. */
.recap-mark {
    position: absolute;
    width: 3px;
    height: 10px;
}

.recap-mark--ours {
    top: 11px;
    background-color: rgb(224, 98, 104);
}

.recap-mark--theirs {
    top: 1px;
    background-color: rgb(84, 189, 130);
}

.recap-track__waning {
    position: absolute;
    top: 0;
    width: 2px;
    height: 22px;
    background-color: rgba(244, 146, 76, 0.85);
}

.recap-track__mid {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    height: 1px;
    background-color: rgba(90, 112, 142, 0.35);
}

.recap-track__axis {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 2px;
    height: 17px;
    min-height: 17px;
    flex-shrink: 0;
}

.recap-axis__label {
    color: rgb(139, 158, 184);
    font-size: 12px;
}

.recap-axis__waning {
    color: rgb(244, 146, 76);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* Replaces the three death lines the gate used to print under the panel: same facts, one row
 * instead of ~90px of stacked labels. The track says WHEN, this says WHO. */
.recap-losses {
    margin-top: 3px;
    height: 18px;
    min-height: 18px;
    flex-shrink: 0;
    color: rgb(214, 226, 242);
    font-size: 13px;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}

/* ---- the gate's own boxes must not squash either -------------------------------------- */
/* This sheet loads after HubStyles, so these win. Same bug, pre-existing elements: the stat
 * card's value spilled outside its background the moment the panel ran short of height. */

.result-gate__stats {
    flex-shrink: 0;
}

.result-stat {
    flex-shrink: 0;
}

/* ---- phone: the gate cannot scroll, so the chart gives up width and detail, not rows ---- */

.layout--phone .recap__split {
    flex-direction: column;
}

/* `flex-basis: 0` + `flex-grow: 1` distributes the MAIN axis. In the desktop row that axis is
 * width, which is what we want. Turning the split into a column makes it HEIGHT — and with no
 * definite height on the split there is no free space to grow into, so both columns resolved to
 * ZERO height and their contents drew on top of each other and on top of the recommendation.
 * On phone the columns size to their content instead. */
.layout--phone .recap__col {
    flex-basis: auto;
    flex-grow: 0;
}

.layout--phone .recap__col--first {
    margin-right: 0;
    margin-bottom: 10px;
}

.layout--phone .recap-row__name {
    width: 96px;
    font-size: 13px;
}

.layout--phone .recap-row__value {
    width: 88px;
    font-size: 13px;
}

.layout--phone .recap-row__sub {
    display: none;
}

.layout--phone .recap__section {
    margin-bottom: 8px;
}
