/* Item 5b — the persistent Hourstone tray (Jake 2026-07-27).
   Three states, one element: collapsed compact tray (every non-combat surface), hover-opened
   drawer (full-size icons, pips, per-icon tooltips), and combat (always expanded — activations
   must be readable at a glance, so hover gates nothing there). Top-center, absolute, so it can
   never participate in — or squash — any screen's flex layout (the flex-shrink lesson). */

.inscription-rail {
    position: absolute;
    top: 6px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.inscription-rail__tray {
    flex-direction: row;
    align-items: center;
    background-color: rgba(13, 20, 30, 0.88);   /* --lh-obsidian, translucent over any surface */
    border-color: rgb(64, 83, 107);              /* --lh-iron */
    border-width: 1px;
    border-radius: 6px;
    padding: 2px 8px;
}

.inscription-rail__slot {
    flex-direction: column;
    align-items: center;
    margin: 0 3px;
}

.inscription-rail__icon {
    font-size: 15px;
    color: rgb(140, 154, 175);                   /* --lh-ash: quiet but readable */
    -unity-text-align: middle-center;
    padding: 1px 3px;
}

/* Open drawer and combat share the expanded look: bigger icons, pips visible. */
.inscription-rail--open .inscription-rail__icon,
.inscription-rail--combat .inscription-rail__icon {
    font-size: 22px;
    padding: 2px 4px;
}

.inscription-rail__icon--live {
    color: rgb(236, 232, 223);                   /* --lh-bone */
    -unity-font-style: bold;
    text-shadow: 0 0 6px rgb(217, 164, 58);      /* --lh-sand glow */
}

.inscription-rail__pips {
    font-size: 9px;
    color: rgb(217, 164, 58);                    /* --lh-sand */
    -unity-text-align: middle-center;
    display: none;
    margin-top: -1px;
}

.inscription-rail--open .inscription-rail__pips,
.inscription-rail--combat .inscription-rail__pips {
    display: flex;
}

/* Collapsed overflow: icons past the cap hide behind a "+N" chip. */
.inscription-rail__more {
    font-size: 11px;
    color: rgb(140, 154, 175);
    margin-left: 4px;
    -unity-text-align: middle-center;
}

.inscription-rail--open .inscription-rail__more,
.inscription-rail--combat .inscription-rail__more {
    display: none;
}

.inscription-rail--open .inscription-rail__slot--overflow,
.inscription-rail--combat .inscription-rail__slot--overflow {
    display: flex;
}

.inscription-rail__slot--overflow {
    display: none;
}

/* Phone: the collapsed tray shrinks rather than colliding with anything. */
.layout--phone .inscription-rail__icon {
    font-size: 13px;
}
