<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="planning-root" class="planning-workspace">
        <ui:VisualElement name="board-hit-surface" class="planning-board-hit" />

        <ui:VisualElement class="planning-topbar panel">
            <ui:VisualElement class="planning-brand">
                <ui:Label text="WARBAND" class="planning-brand__name" />
                <ui:Label name="act" class="planning-topbar__value" />
            </ui:VisualElement>
            <ui:VisualElement name="track" class="planning-track" />
            <ui:VisualElement class="planning-resources">
                <ui:VisualElement class="planning-resource">
                    <ui:Label text="SAND" class="planning-resource__label" />
                    <ui:Label name="sand" class="planning-resource__value planning-resource__value--sand" />
                </ui:VisualElement>
                <ui:VisualElement class="planning-resource">
                    <ui:Label text="FIELD" class="planning-resource__label" />
                    <ui:Label name="capacity" class="planning-resource__value" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="planning-encounter panel">
            <ui:VisualElement class="planning-panel-heading">
                <ui:VisualElement>
                    <ui:Label name="beat" class="eyebrow" />
                    <ui:Label name="heading" class="planning-encounter__title" />
                </ui:VisualElement>
                <ui:Label text="FULL INTEL" class="public-info-pill" />
            </ui:VisualElement>
            <ui:Label name="brief" class="planning-encounter__brief" />
            <ui:VisualElement name="rule-box" class="planning-rule">
                <ui:Label name="rule" class="planning-rule__copy" />
            </ui:VisualElement>
            <ui:VisualElement name="risk-list" class="planning-risk-list" />
            <ui:Label text="ENEMY FORMATION" class="planning-section-label" />
            <ui:ScrollView
                name="enemy-scroll"
                mode="Vertical"
                horizontal-scroller-visibility="Hidden"
                vertical-scroller-visibility="Auto"
                class="planning-enemy-scroll">
                <ui:VisualElement name="enemy-list" class="planning-enemy-list" />
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="inspector-slot" class="planning-inspector-slot" />
        <ui:Label name="feedback" class="feedback-label planning-feedback" />

        <ui:VisualElement class="planning-dock panel">
            <ui:VisualElement name="tabs" class="planning-tabs">
                <ui:Button name="tab-muster" text="MUSTER" class="planning-tab" />
                <ui:Button name="tab-market" text="MARKET" class="planning-tab" />
                <ui:Button name="tab-armory" text="ARMORY" class="planning-tab" />
                <ui:Button name="tab-hourstone" text="HOURSTONE" class="planning-tab" />
            </ui:VisualElement>
            <ui:VisualElement class="planning-dock__body">
                <ui:ScrollView
                    name="dock-scroll"
                    mode="Horizontal"
                    horizontal-scroller-visibility="Auto"
                    vertical-scroller-visibility="Hidden"
                    class="planning-dock__scroll">
                    <ui:VisualElement name="dock-content" class="planning-dock__content" />
                </ui:ScrollView>
                <ui:VisualElement class="planning-dock__actions">
                    <ui:Label name="dock-note" class="planning-dock__note" />
                    <ui:Button name="secondary" class="btn btn--ghost planning-secondary" />
                    <ui:Button name="commit" class="btn btn--primary planning-commit" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="modal-scrim" class="modal-scrim">
            <ui:VisualElement class="modal planning-choice-modal">
                <ui:Label name="modal-eyebrow" class="eyebrow" />
                <ui:Label name="modal-title" class="planning-choice-modal__title" />
                <ui:Label name="modal-copy" class="planning-choice-modal__copy" />
                <ui:VisualElement name="modal-options" class="planning-choice-modal__options" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
