<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="management-root" class="management-screen hub">
        <ui:VisualElement name="safe-frame" class="hub-safe-frame">
            <ui:VisualElement class="management-topbar hub-topbar hub-run-ribbon">
                <ui:VisualElement class="management-brand">
                    <ui:Label text="WARBAND" class="management-brand__name" />
                    <ui:Label name="act" class="management-brand__act" />
                </ui:VisualElement>
                <ui:VisualElement name="track" class="management-track" />
                <ui:VisualElement class="management-resources">
                    <ui:VisualElement class="management-resource management-resource--sand">
                        <ui:Label text="SAND" class="management-resource__label" />
                        <ui:Label name="sand" class="management-resource__value management-resource__value--sand" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="hub-overview" class="hub-overview">
                <ui:VisualElement class="hub-overview__heading">
                    <ui:Label text="THE HOURSTONE TABLE" class="hub-overview__title" />
                    <ui:Label name="overview-copy" class="hub-overview__copy" />
                </ui:VisualElement>

                <ui:VisualElement class="hub-table">
                    <ui:VisualElement class="hub-table__grain" />
                    <ui:VisualElement class="hub-table__ring hub-table__ring--outer" />
                    <ui:VisualElement class="hub-table__ring hub-table__ring--inner" />
                    <ui:VisualElement class="hub-table__axis hub-table__axis--horizontal" />
                    <ui:VisualElement class="hub-table__axis hub-table__axis--vertical" />

                    <ui:Button name="station-breach" class="hub-station hub-station--breach">
                        <ui:Label name="breach-sigil" class="hub-station__sigil" />
                        <ui:VisualElement class="hub-station__copy">
                            <ui:Label name="breach-eyebrow" class="hub-station__eyebrow" />
                            <ui:Label name="breach-name" class="hub-station__name" />
                            <ui:Label name="breach-status" class="hub-station__status" />
                        </ui:VisualElement>
                        <ui:Label name="breach-attention" text="READY" class="hub-station__attention" />
                    </ui:Button>

                    <ui:Button name="station-market" class="hub-station hub-station--market">
                        <ui:Label name="market-sigil" class="hub-station__sigil" />
                        <ui:VisualElement class="hub-station__copy">
                            <ui:Label name="market-eyebrow" class="hub-station__eyebrow" />
                            <ui:Label name="market-name" class="hub-station__name" />
                            <ui:Label name="market-status" class="hub-station__status" />
                        </ui:VisualElement>
                        <ui:Label name="market-attention" text="NEW" class="hub-station__attention" />
                    </ui:Button>

                    <ui:Button name="station-hourstone" class="hub-station hub-station--hourstone">
                        <ui:Label name="hourstone-sigil" class="hub-station__sigil hub-station__sigil--hourstone" />
                        <ui:VisualElement class="hub-station__copy hub-station__copy--center">
                            <ui:Label name="hourstone-eyebrow" class="hub-station__eyebrow" />
                            <ui:Label name="hourstone-name" class="hub-station__name hub-station__name--center" />
                            <ui:Label name="hourstone-status" class="hub-station__status" />
                        </ui:VisualElement>
                        <ui:Label name="hourstone-attention" text="NEW" class="hub-station__attention" />
                    </ui:Button>

                    <ui:Button name="station-armory" class="hub-station hub-station--armory">
                        <ui:Label name="armory-sigil" class="hub-station__sigil" />
                        <ui:VisualElement class="hub-station__copy">
                            <ui:Label name="armory-eyebrow" class="hub-station__eyebrow" />
                            <ui:Label name="armory-name" class="hub-station__name" />
                            <ui:Label name="armory-status" class="hub-station__status" />
                        </ui:VisualElement>
                        <ui:Label name="armory-attention" text="NEW" class="hub-station__attention" />
                    </ui:Button>

                    <ui:Button name="station-warband" class="hub-station hub-station--warband">
                        <ui:Label name="warband-sigil" class="hub-station__sigil" />
                        <ui:VisualElement class="hub-station__copy">
                            <ui:Label name="warband-eyebrow" class="hub-station__eyebrow" />
                            <ui:Label name="warband-name" class="hub-station__name" />
                            <ui:Label name="warband-status" class="hub-station__status" />
                        </ui:VisualElement>
                        <ui:Label name="warband-attention" text="NEW" class="hub-station__attention" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="hub-recommendation">
                    <ui:Label text="RECOMMENDED" class="hub-recommendation__label" />
                    <ui:Label name="recommendation" class="hub-recommendation__value" />
                    <ui:Label text="Choose any station. Nothing commits until you use an explicit action." class="hub-recommendation__hint" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="hub-workspace" class="hub-workspace">
                <ui:VisualElement class="hub-workspace__header">
                    <ui:Button name="overview-back" text="‹  TABLE" class="btn btn--ghost hub-back" />
                    <ui:VisualElement class="hub-workspace__heading">
                        <ui:Label name="station-eyebrow" class="eyebrow hub-workspace__eyebrow" />
                        <ui:Label name="heading" class="hub-workspace__title" />
                        <ui:Label name="brief" class="hub-workspace__brief" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-anchor-rail">
                        <ui:Button name="anchor-market" text="MARKET" class="hub-anchor" />
                        <ui:Button name="anchor-warband" text="WARBAND" class="hub-anchor" />
                        <ui:Button name="anchor-armory" text="ARMORY" class="hub-anchor" />
                        <ui:Button name="anchor-hourstone" text="HOURSTONE" class="hub-anchor" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="hub-workspace__body">
                    <ui:VisualElement class="hub-workspace__instrument">
                        <ui:VisualElement class="hub-instrument__rail hub-instrument__rail--left" />
                        <ui:VisualElement class="hub-instrument__rail hub-instrument__rail--center" />
                        <ui:VisualElement class="hub-instrument__rail hub-instrument__rail--right" />
                        <ui:VisualElement class="hub-instrument__socket" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-collection">
                        <ui:VisualElement class="hub-collection__toolbar">
                            <ui:Label name="tab-note" class="hub-collection__note" />
                            <ui:Button name="secondary" class="btn btn--ghost management-secondary" />
                        </ui:VisualElement>
                        <ui:ScrollView
                            name="content-scroll"
                            mode="Vertical"
                            horizontal-scroller-visibility="Hidden"
                            vertical-scroller-visibility="Hidden"
                            class="hub-collection__scroll">
                            <ui:Label name="market-page" class="market-offer-page" />
                            <ui:Label name="primary-label" class="hub-section-label" />
                            <ui:VisualElement name="primary-grid" class="hub-card-grid" />
                            <ui:Label name="secondary-label" class="hub-section-label hub-section-label--secondary" />
                            <ui:VisualElement name="secondary-grid" class="hub-card-grid" />
                            <ui:Label name="empty" class="management-empty" />
                        </ui:ScrollView>
                        <ui:Label name="feedback" class="feedback-label management-feedback" />
                        <ui:VisualElement name="selection-tray" class="hub-selection-tray">
                            <ui:VisualElement class="hub-selection-tray__identity">
                                <ui:Label name="selection-tray-eyebrow" class="hub-selection-tray__eyebrow" />
                                <ui:Label name="selection-tray-title" class="hub-selection-tray__title" />
                                <ui:Label name="selection-tray-summary" class="hub-selection-tray__summary" />
                                <ui:Label name="selection-tray-basic" class="hub-selection-tray__basic" />
                            </ui:VisualElement>
                            <ui:Label name="selection-tray-price" class="hub-selection-tray__price" />
                            <ui:VisualElement class="hub-selection-tray__commands">
                                <ui:Button name="selection-tray-inspect" text="INSPECT" class="btn btn--ghost hub-selection-tray__inspect" />
                                <ui:VisualElement name="selection-tray-actions" class="hub-selection-tray__actions" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="inspector-scrim" class="hub-inspector-scrim">
                        <ui:VisualElement name="inspector-pane" class="hub-inspector-pane">
                            <ui:VisualElement class="hub-inspector-pane__top">
                                <ui:Label text="SELECTED CARD" class="hub-inspector-pane__label" />
                                <ui:Button name="inspector-close" text="EXPAND  ↗" class="btn btn--ghost hub-inspector-close" />
                            </ui:VisualElement>
                            <ui:ScrollView
                                mode="Vertical"
                                horizontal-scroller-visibility="Hidden"
                                vertical-scroller-visibility="Hidden"
                                class="hub-inspector-scroll">
                                <ui:VisualElement name="inspector-slot" class="hub-inspector-slot" />
                            </ui:ScrollView>
                            <ui:VisualElement
                                name="inspector-action-dock"
                                class="hub-inspector-action-dock" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="loadout-scrim" class="loadout-scrim">
                        <ui:VisualElement name="loadout-table" class="loadout-table">
                            <ui:VisualElement class="loadout-table__header">
                                <ui:VisualElement>
                                    <ui:Label text="THE LOADOUT TABLE" class="loadout-table__title" />
                                    <ui:Label text="Formation, equipment, and exact consequences in one instrument." class="loadout-table__copy" />
                                </ui:VisualElement>
                                <ui:Button name="loadout-close" text="CLOSE  ×" class="btn btn--ghost loadout-table__close" />
                            </ui:VisualElement>
                            <ui:VisualElement class="loadout-table__body">
                                <ui:VisualElement class="loadout-column loadout-column--formation">
                                    <ui:Label text="FIELD" class="loadout-column__label" />
                                    <ui:VisualElement name="loadout-field" class="loadout-slot-list" />
                                    <ui:Label text="RESERVES" class="loadout-column__label loadout-column__label--reserve" />
                                    <ui:VisualElement name="loadout-reserve" class="loadout-slot-list" />
                                </ui:VisualElement>
                                <ui:VisualElement class="loadout-column loadout-column--champion">
                                    <ui:Label text="SELECTED CHAMPION" class="loadout-column__label" />
                                    <ui:ScrollView
                                        mode="Vertical"
                                        horizontal-scroller-visibility="Hidden"
                                        vertical-scroller-visibility="Hidden"
                                        class="loadout-champion-scroll">
                                        <ui:VisualElement name="loadout-inspector-slot" class="loadout-inspector-slot" />
                                    </ui:ScrollView>
                                    <ui:VisualElement name="loadout-action-dock" class="loadout-action-dock" />
                                </ui:VisualElement>
                                <ui:VisualElement class="loadout-column loadout-column--armory">
                                    <ui:VisualElement class="loadout-armory-heading">
                                        <ui:Label text="STORED EQUIPMENT" class="loadout-column__label" />
                                        <ui:Label name="loadout-stored-count" class="loadout-armory-count" />
                                    </ui:VisualElement>
                                    <ui:ScrollView
                                        mode="Vertical"
                                        horizontal-scroller-visibility="Hidden"
                                        vertical-scroller-visibility="Hidden"
                                        class="loadout-inventory-scroll">
                                        <ui:VisualElement name="loadout-inventory" class="loadout-inventory" />
                                        <ui:VisualElement
                                            name="loadout-inventory-empty"
                                            class="loadout-inventory-empty">
                                            <ui:Label text="◇" class="loadout-inventory-empty__mark" />
                                            <ui:Label text="ARMORY CLEAR" class="loadout-inventory-empty__title" />
                                            <ui:Label
                                                text="Weapons and trinkets bought at the Market arrive here ready to compare and equip."
                                                class="loadout-inventory-empty__copy" />
                                        </ui:VisualElement>
                                    </ui:ScrollView>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="warband-shelf" class="warband-shelf">
                    <ui:Button name="shelf-expand" class="warband-shelf__identity">
                        <ui:Label text="WARBAND" class="warband-shelf__eyebrow" />
                        <ui:Label name="shelf-capacity" class="warband-shelf__capacity" />
                        <ui:Label text="MANAGE  ⌃" class="warband-shelf__manage" />
                    </ui:Button>
                    <ui:VisualElement name="shelf-field" class="warband-shelf__slots warband-shelf__slots--field" />
                    <ui:VisualElement class="warband-shelf__divider" />
                    <ui:VisualElement class="warband-shelf__reserve">
                        <ui:Label name="shelf-reserve-label" class="warband-shelf__section-label" />
                        <ui:VisualElement name="shelf-reserve" class="warband-shelf__slots" />
                    </ui:VisualElement>
                    <ui:Button name="shelf-armory" class="warband-shelf__armory">
                        <ui:Label text="ARMORY" class="warband-shelf__section-label" />
                        <ui:Label name="shelf-stored-count" class="warband-shelf__stored-count" />
                        <ui:VisualElement name="shelf-stored-icons" class="warband-shelf__stored-icons" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="hub-workspace__footer">
                    <ui:Label name="workspace-hint" class="hub-workspace__hint" />
                    <ui:Button name="continue" class="btn btn--primary management-continue" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="rotate-device" class="hub-rotate-device">
            <ui:VisualElement class="hub-rotate-device__instrument">
                <ui:Label text="↻" class="hub-rotate-device__icon" />
                <ui:Label text="TURN THE HOURSTONE" class="hub-rotate-device__title" />
                <ui:Label text="Warband is built for landscape play." class="hub-rotate-device__copy" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="choice-scrim" class="modal-scrim">
            <ui:VisualElement class="modal management-choice-modal">
                <ui:Label name="choice-eyebrow" class="eyebrow" />
                <ui:Label name="choice-title" class="management-choice-modal__title" />
                <ui:Label name="choice-copy" class="management-choice-modal__copy" />
                <ui:ScrollView
                    mode="Vertical"
                    horizontal-scroller-visibility="Hidden"
                    vertical-scroller-visibility="Auto"
                    class="management-choice-modal__scroll">
                    <ui:VisualElement name="choice-options" class="management-choice-modal__options" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
